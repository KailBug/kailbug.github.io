---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
    {
        title: 'kailbug.github.io',
        category: 'Personal Project',
        description: '使用 Astro、TypeScript、Markdown 和 GitHub Pages 构建的个人技术主页与知识库。',
        status: 'Active',
        href: 'https://github.com/KailBug/kailbug.github.io',
        stack: ['Astro', 'TypeScript', 'Markdown'],
    },
];
---

<BaseLayout
    title="Projects | KailBug"
    description="Open-source contributions, Agent experiments and personal software projects."
>
    <main class="projects-page">
        <header class="page-header" data-reveal>
            <p class="eyebrow"><span></span> BUILDING IN PUBLIC</p>
            <div class="title-row">
                <h1>Things I<br /><em>make.</em></h1>
                <div class="project-aside">
                    <div class="build-reactor" data-build-reactor aria-hidden="true">
                        <span class="reactor-aura"></span>
                        <div class="reactor-goo">
                            <span class="reactor-core"></span>
                            <span class="reactor-node reactor-node--idea" data-reactor-node="idea"><i></i></span>
                            <span class="reactor-node reactor-node--code" data-reactor-node="code"><i></i></span>
                            <span class="reactor-node reactor-node--ship" data-reactor-node="ship"><i></i></span>
                        </div>
                        <span class="reactor-mark">K</span>
                        <span class="reactor-label reactor-label--idea" data-reactor-label="idea">IDEA</span>
                        <span class="reactor-label reactor-label--code" data-reactor-label="code">CODE</span>
                        <span class="reactor-label reactor-label--ship" data-reactor-label="ship">SHIP</span>
                        <span class="reactor-hint">DRAG TO BUILD</span>
                    </div>
                    <p>Open-source contributions, Agent experiments and personal software projects.</p>
                </div>
            </div>
        </header>

        <section class="project-grid" aria-label="项目列表" data-reveal>
            {projects.map((project, index) => (
                <article class="project-card liquid-shell" data-tilt>
                    <div class="project-info">
                        <div class="project-meta">
                            <span>{String(index + 1).padStart(2, '0')} / {project.category}</span>
                            <span class:list={['status', { active: project.status === 'Active' }]}>
                                <i></i>{project.status}
                            </span>
                        </div>

                        <h2>{project.title}</h2>
                        <p>{project.description}</p>

                        <ul class="stack" aria-label="技术栈">
                            {project.stack.map((item) => <li>{item}</li>)}
                        </ul>

                        {project.href ? (
                            <a class="project-link" href={project.href} target="_blank" rel="noreferrer">
                                View Repository <span>↗</span>
                            </a>
                        ) : (
                            <span class="coming-soon">Coming soon</span>
                        )}
                    </div>

                    <div class="project-visual" aria-hidden="true">
                        <div class="visual-backdrop"></div>
                        <div class="browser-card">
                            <div class="browser-bar">
                                <span></span><span></span><span></span>
                                <i>kailbug.github.io</i>
                            </div>
                            <div class="browser-content">
                                <span class="tiny-label">AGENT ENGINEERING</span>
                                <strong>Build reliable<br />AI agents.</strong>
                                <div class="code-lines"><i></i><i></i><i></i></div>
                            </div>
                        </div>
                        <span class="visual-chip visual-chip--astro">A</span>
                        <span class="visual-chip visual-chip--code">&lt;/&gt;</span>
                    </div>
                </article>
            ))}
        </section>

        <div class="project-note" data-reveal>
            <span class="note-orb" aria-hidden="true">+</span>
            <div>
                <strong>More experiments are taking shape.</strong>
                <p>代码、文章和实验会在这里持续生长。</p>
            </div>
        </div>
    </main>

    <script is:inline>
        (() => {
            const reactor = document.querySelector('[data-build-reactor]');
            if (!reactor) return;

            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const definitions = {
                idea: [-104, -7],
                code: [102, -9],
                ship: [47, 40],
            };
            const nodes = Array.from(reactor.querySelectorAll('[data-reactor-node]')).map((element) => {
                const id = element.dataset.reactorNode;
                const [baseX, baseY] = definitions[id];
                return {
                    id,
                    element,
                    label: reactor.querySelector(`[data-reactor-label="${id}"]`),
                    baseX,
                    baseY,
                    x: baseX,
                    y: baseY,
                    vx: 0,
                    vy: 0,
                    dragging: false,
                };
            });

            let pointer = null;
            let activeNode = null;
            let scale = 1;
            let centerX = 0;
            let centerY = 0;

            const resize = () => {
                const bounds = reactor.getBoundingClientRect();
                scale = Math.min(1, bounds.width / 312);
                centerX = bounds.width / 2;
                centerY = bounds.height / 2 - (4 * scale);
            };

            const positionNode = (node) => {
                const x = centerX + (node.x * scale);
                const y = centerY + (node.y * scale);
                node.element.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
                node.label.style.transform = `translate3d(${x}px, ${y - (31 * scale)}px, 0) translate(-50%, -50%)`;
            };

            const setPointer = (event) => {
                const bounds = reactor.getBoundingClientRect();
                pointer = {
                    x: (event.clientX - bounds.left - centerX) / scale,
                    y: (event.clientY - bounds.top - centerY) / scale,
                };
            };

            const frame = () => {
                nodes.forEach((node) => {
                    let targetX = node.baseX;
                    let targetY = node.baseY;

                    if (node.dragging && pointer) {
                        const radius = 126;
                        const distance = Math.hypot(pointer.x, pointer.y);
                        const limit = distance > radius ? radius / distance : 1;
                        targetX = pointer.x * limit;
                        targetY = pointer.y * limit;
                    } else if (pointer) {
                        const dx = pointer.x - node.x;
                        const dy = pointer.y - node.y;
                        const distance = Math.hypot(dx, dy);
                        const pull = Math.max(0, 1 - (distance / 94));
                        targetX += (pointer.x - node.baseX) * pull * .24;
                        targetY += (pointer.y - node.baseY) * pull * .24;
                    }

                    const spring = node.dragging ? .2 : .058;
                    const damping = node.dragging ? .72 : .79;
                    node.vx = (node.vx + ((targetX - node.x) * spring)) * damping;
                    node.vy = (node.vy + ((targetY - node.y) * spring)) * damping;
                    node.x += node.vx;
                    node.y += node.vy;

                    const close = pointer && Math.hypot(pointer.x - node.x, pointer.y - node.y) < 54;
                    node.label.classList.toggle('is-visible', Boolean(close || node.dragging));
                    positionNode(node);
                });

                reactor.classList.toggle('is-active', Boolean(pointer || activeNode));
                requestAnimationFrame(frame);
            };

            resize();
            nodes.forEach(positionNode);

            if (reducedMotion) return;

            reactor.addEventListener('pointermove', (event) => setPointer(event));
            reactor.addEventListener('pointerenter', (event) => setPointer(event));
            reactor.addEventListener('pointerleave', () => {
                if (!activeNode) pointer = null;
            });

            nodes.forEach((node) => {
                node.element.addEventListener('pointerdown', (event) => {
                    event.preventDefault();
                    setPointer(event);
                    activeNode = node;
                    node.dragging = true;
                    node.element.classList.add('is-dragging');
                    node.element.setPointerCapture(event.pointerId);
                });

                const release = (event) => {
                    if (!node.dragging) return;
                    node.dragging = false;
                    activeNode = null;
                    node.element.classList.remove('is-dragging');
                    if (node.element.hasPointerCapture(event.pointerId)) {
                        node.element.releasePointerCapture(event.pointerId);
                    }
                    if (!reactor.matches(':hover')) pointer = null;
                };

                node.element.addEventListener('pointerup', release);
                node.element.addEventListener('pointercancel', release);
            });

            window.addEventListener('resize', resize, { passive: true });
            requestAnimationFrame(frame);
        })();
    </script>
</BaseLayout>

<style>
    .projects-page { width: var(--page-width); margin: 0 auto; padding: 54px 0 30px; }
    .page-header { min-height: 450px; margin-bottom: 76px; padding-top: 0; box-sizing: border-box; }
    .build-reactor { position: relative; width: 312px; height: 150px; margin: 0 0 32px; cursor: default; user-select: none; -webkit-user-select: none; }
    .reactor-aura { position: absolute; top: 50%; left: 50%; width: 132px; height: 65px; border-radius: 50%; opacity: .32; background: radial-gradient(ellipse, rgb(112 96 248 / 28%), transparent 70%); filter: blur(13px); pointer-events: none; transform: translate(-50%, -50%); transition: opacity 300ms ease, transform 600ms var(--ease-spring); }
    .build-reactor.is-active .reactor-aura { opacity: .58; transform: translate(-50%, -50%) scale(1.16); }
    .reactor-goo { position: absolute; inset: 0; filter: url('#goo'); }
    .reactor-core { position: absolute; top: calc(50% - 4px); left: 50%; width: 62px; height: 62px; border-radius: 44% 56% 54% 46% / 47% 42% 58% 53%; background: linear-gradient(145deg, #7d6df7, var(--color-accent)); box-shadow: inset 8px 10px 15px rgb(255 255 255 / 23%), inset -9px -11px 18px rgb(36 25 145 / 18%); pointer-events: none; transform: translate(-50%, -50%); animation: reactor-breathe 5.2s ease-in-out infinite; }
    .reactor-node { position: absolute; top: 0; left: 0; z-index: 2; display: grid; width: 43px; height: 43px; cursor: grab; touch-action: none; place-items: center; will-change: transform; }
    .reactor-node.is-dragging { z-index: 4; cursor: grabbing; }
    .reactor-node i { display: block; width: 31px; height: 31px; border-radius: 48% 52% 42% 58% / 55% 44% 56% 45%; box-shadow: inset 4px 5px 7px rgb(255 255 255 / 42%), inset -5px -6px 9px rgb(25 49 43 / 10%), 0 7px 13px rgb(42 75 70 / 11%); transition: transform 420ms var(--ease-spring); animation: reactor-orbit 4.8s ease-in-out infinite; }
    .reactor-node:hover i, .reactor-node.is-dragging i { transform: scale(1.22); }
    .reactor-node--idea i { background: var(--color-lime); }
    .reactor-node--code i { background: var(--color-cyan); animation-delay: -1.6s; }
    .reactor-node--ship i { background: #f6f8f4; border: 1px solid rgb(128 143 139 / 14%); animation-delay: -3.1s; }
    .reactor-mark { position: absolute; z-index: 3; top: calc(50% - 4px); left: 50%; color: white; font: 700 1rem 'DM Mono', monospace; pointer-events: none; transform: translate(-50%, -50%); }
    .reactor-label { position: absolute; z-index: 5; top: 0; left: 0; padding: 3px 6px; border: 1px solid var(--color-border); border-radius: 999px; opacity: 0; background: var(--color-surface-strong); box-shadow: var(--shadow-micro); color: var(--color-text); font: 500 .48rem 'DM Mono', monospace; letter-spacing: .08em; pointer-events: none; transition: opacity 180ms ease; white-space: nowrap; will-change: transform; }
    .reactor-label.is-visible { opacity: 1; }
    .reactor-hint { position: absolute; right: 1px; bottom: 1px; color: var(--color-muted); font: 500 .42rem 'DM Mono', monospace; letter-spacing: .12em; opacity: .48; transition: opacity 250ms ease; }
    .build-reactor.is-active .reactor-hint { opacity: .85; }
    @keyframes reactor-breathe { 0%, 100% { border-radius: 44% 56% 54% 46% / 47% 42% 58% 53%; transform: translate(-50%, -50%) scale(1); } 50% { border-radius: 56% 44% 47% 53% / 42% 56% 44% 58%; transform: translate(-50%, -50%) scale(1.055); } }
    @keyframes reactor-orbit { 0%, 100% { border-radius: 48% 52% 42% 58% / 55% 44% 56% 45%; } 50% { border-radius: 57% 43% 54% 46% / 43% 57% 45% 55%; } }
    .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 30px; color: var(--color-muted); font: 500 .68rem 'DM Mono', monospace; letter-spacing: .14em; }
    .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--color-lime); box-shadow: 0 0 0 5px rgb(185 243 106 / 16%); }
    .title-row { display: flex; align-items: start; justify-content: space-between; gap: 60px; }
    h1 { margin: 0; font-size: clamp(4.5rem, 11vw, 8rem); font-weight: 670; line-height: .83; letter-spacing: -.08em; }
    h1 em { position: relative; z-index: 0; font-style: normal; }
    h1 em::after { position: absolute; z-index: -1; right: -.08em; bottom: .01em; left: -.04em; height: .3em; border-radius: 999px 48% 999px 45%; background: linear-gradient(90deg, var(--color-lime), var(--color-cyan)); box-shadow: inset 0 2px 2px rgb(255 255 255 / 58%); content: ''; transform: rotate(-1deg); }
    .project-aside { display: flex; width: min(100%, 390px); min-height: 286px; flex: 0 0 auto; flex-direction: column; align-items: flex-start; justify-content: flex-start; margin-top: -42px; padding-top: 24px; }
    .project-aside > p { max-width: 330px; margin: 0; color: var(--color-muted); font-size: .9rem; line-height: 1.8; }

    .project-grid { display: grid; width: 100%; gap: 24px; }
    .project-card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); min-height: 371px; overflow: hidden; border-radius: 32px 42px 30px 38px; }
    .project-info { display: flex; min-width: 0; flex-direction: column; padding: 36px; }
    .project-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--color-muted); font: 500 .59rem 'DM Mono', monospace; letter-spacing: .06em; }
    .status { display: inline-flex; align-items: center; gap: 7px; padding: 6px 9px; border: 1px solid var(--color-border); border-radius: 999px; background: rgb(128 143 139 / 6%); }
    .status i { width: 5px; height: 5px; border-radius: 50%; background: var(--color-muted); }
    .status.active { color: var(--color-text); }
    .status.active i { background: #69d879; box-shadow: 0 0 0 4px rgb(105 216 121 / 15%); }
    h2 { margin: 46px 0 16px; overflow-wrap: anywhere; font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 650; line-height: 1.04; letter-spacing: -.06em; }
    .project-info > p { max-width: 470px; margin: 0; color: var(--color-muted); font-size: .82rem; line-height: 1.75; }
    .stack { display: flex; flex-wrap: wrap; gap: 7px; margin: 22px 0 0; padding: 0; list-style: none; }
    .stack li { padding: 6px 10px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-muted); font: 400 .56rem 'DM Mono', monospace; }
    .project-link { position: relative; z-index: 3; display: inline-flex; align-items: center; justify-content: space-between; align-self: flex-start; min-width: 170px; margin-top: auto; padding: 7px 8px 7px 16px; border-radius: 15px 18px 14px 17px; background: var(--color-text); color: var(--color-background); font-size: .72rem; font-weight: 700; text-decoration: none; }
    .project-link span { display: grid; width: 34px; height: 34px; border-radius: 11px 13px 10px 12px; background: var(--color-lime); color: #18201e; place-items: center; transition: transform 520ms var(--ease-spring); }
    .project-link:hover span { transform: rotate(42deg); }

    .project-visual { position: relative; display: grid; overflow: hidden; min-height: 371px; background: radial-gradient(circle at 30% 20%, rgb(255 255 255 / 45%), transparent 28%), linear-gradient(145deg, var(--color-cyan), var(--color-accent-soft) 52%, var(--color-lime)); place-items: center; }
    .visual-backdrop { position: absolute; inset: -15%; opacity: .35; background: repeating-radial-gradient(circle at center, transparent 0 27px, rgb(24 32 30 / 12%) 28px 29px); transform: rotate(-12deg); }
    .browser-card { position: relative; width: min(84%, 400px); min-height: 260px; overflow: hidden; border: 1px solid rgb(255 255 255 / 58%); border-radius: 24px 30px 22px 27px; background: rgb(247 250 247 / 72%); box-shadow: 0 35px 60px rgb(42 75 70 / 23%), inset 0 1px 0 rgb(255 255 255 / 86%); transform: rotate(-4deg); backdrop-filter: blur(14px); transition: transform 700ms var(--ease-spring); }
    .project-card:hover .browser-card { transform: rotate(1deg) translateY(-7px) scale(1.02); }
    .browser-bar { display: flex; align-items: center; gap: 5px; height: 42px; padding: 0 14px; border-bottom: 1px solid rgb(24 32 30 / 10%); }
    .browser-bar span { width: 6px; height: 6px; border-radius: 50%; background: rgb(24 32 30 / 20%); }
    .browser-bar i { margin-left: auto; color: #66716e; font: 400 .52rem 'DM Mono', monospace; font-style: normal; }
    .browser-content { padding: 36px 24px; color: #18201e; }
    .tiny-label { font: 500 .52rem 'DM Mono', monospace; letter-spacing: .1em; }
    .browser-content strong { display: block; margin-top: 18px; font-size: 1.8rem; line-height: .96; letter-spacing: -.07em; }
    .code-lines { display: grid; gap: 7px; margin-top: 30px; }
    .code-lines i { height: 6px; border-radius: 999px; background: rgb(24 32 30 / 11%); }
    .code-lines i:nth-child(1) { width: 78%; } .code-lines i:nth-child(2) { width: 55%; } .code-lines i:nth-child(3) { width: 68%; }
    .visual-chip { position: absolute; display: grid; border: 4px solid rgb(243 246 243 / 80%); box-shadow: 0 16px 28px rgb(42 75 70 / 18%), inset 0 1px 2px rgb(255 255 255 / 55%); color: #18201e; font-weight: 800; place-items: center; transition: transform 650ms var(--ease-spring); }
    .visual-chip--astro { top: 28px; right: 18px; width: 50px; height: 50px; border-radius: 17px 21px 16px 19px; background: var(--color-lime); transform: rotate(9deg); }
    .visual-chip--code { right: 20px; bottom: 30px; width: 60px; height: 60px; border-radius: 20px 25px 19px 23px; background: var(--color-accent); color: white; font: 700 .7rem 'DM Mono', monospace; transform: rotate(-6deg); }
    .project-card:hover .visual-chip--astro { transform: rotate(-5deg) translateY(-8px); }
    .project-card:hover .visual-chip--code { transform: rotate(7deg) translateY(5px); }

    .project-note { display: flex; align-items: center; gap: 17px; width: max-content; margin: 34px auto 0; color: var(--color-muted); }
    .note-orb { display: grid; width: 42px; height: 42px; border: 1px solid var(--color-border); border-radius: 14px 17px 13px 16px; background: var(--color-surface); box-shadow: var(--shadow-micro); color: var(--color-accent); place-items: center; }
    .project-note strong { color: var(--color-text); font-size: .78rem; }
    .project-note p { margin: 4px 0 0; font-size: .68rem; }

    @media (max-width: 850px) {
        .title-row { align-items: flex-start; flex-direction: column; }
        .project-aside { width: 100%; min-height: 0; margin-top: 0; padding-top: 0; }
        .project-card { grid-template-columns: 1fr; }
        .project-visual { min-height: 360px; }
        .project-info { min-height: 420px; }
    }

    @media (max-width: 620px) {
        .projects-page { width: min(100% - 24px, 1120px); padding-top: 52px; }
        .page-header { min-height: 630px; margin-bottom: 58px; padding-top: 0; }
        .build-reactor { width: 260px; height: 96px; margin: 0 0 22px; }
        .title-row { align-items: flex-start; flex-direction: column; gap: 38px; }
        h1 { font-size: clamp(4.4rem, 20vw, 6.8rem); }
        .project-card { border-radius: 27px 33px 25px 30px; }
        .project-info { min-height: 500px; padding: 27px; }
        .project-meta { align-items: flex-start; }
        h2 { margin-top: 60px; }
        .project-visual { min-height: 350px; }
        .browser-card { width: 86%; min-height: 260px; }
        .browser-content { padding: 35px 25px; }
        .browser-content strong { font-size: 2rem; }
        .visual-chip--astro { top: 25px; right: 16px; }
        .visual-chip--code { right: 20px; bottom: 26px; }
        .project-note { width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
        .reactor-core, .reactor-node i { animation: none; }
        .reactor-aura, .reactor-node i, .reactor-label { transition: none; }
    }
</style>
