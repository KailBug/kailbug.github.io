---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (
    await getCollection('blog', ({ data }) => !data.draft)
).sort((a, b) => {
    const dateDifference = b.data.date.valueOf() - a.data.date.valueOf();
    return dateDifference || b.id.localeCompare(a.id);
});

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
});

function estimateReadingMinutes(body = '') {
    const chineseCharacters = body.match(/[\u3400-\u9fff]/g)?.length ?? 0;
    const englishWords = body.replace(/[\u3400-\u9fff]/g, ' ').match(/[a-zA-Z0-9]+/g)?.length ?? 0;
    return Math.max(1, Math.ceil(chineseCharacters / 400 + englishWords / 220));
}
---

<BaseLayout
    title="Articles | KailBug"
    description="关于 Agent Engineering 与软件工程的技术文章"
>
    <main class="articles-page">
        <header class="page-header" data-reveal>
            <div class="page-heading">
                <p class="eyebrow"><span></span> NOTES / ARTICLES</p>
                <h1>Ideas in<br /><span>motion.</span></h1>
                <p class="intro">有些地方不只是技术，当然我说的不只是这里。</p>
            </div>

            <div class="page-orb" data-article-orb aria-label="可拖动的液态轨道组件">
                <span class="orb-main" data-orb-node="main"><i>✦</i></span>
                <span class="orb-small" data-orb-node="small"></span>
                <span class="orb-ring" data-orb-node="ring"></span>
                <span class="orb-hint">DRAG THE ORBIT</span>
            </div>
        </header>

        <div class="list-heading" data-reveal>
            <span>INDEX / {String(articles.length).padStart(2, '0')}</span>
            <span>Newest first</span>
        </div>

        <section class="article-list" aria-label="文章列表" data-reveal>
            {articles.map((article, index) => (
                <article class="article-card liquid-shell" data-tilt>
                    <div class="article-index">{String(articles.length - index).padStart(2, '0')}</div>

                    <div class="article-body">
                        <div class="meta">
                            <span>{article.data.category}</span>
                            <time datetime={article.data.date.toISOString()}>
                                {dateFormatter.format(article.data.date)}
                            </time>
                            <span>{estimateReadingMinutes(article.body)} 分钟阅读</span>
                        </div>

                        <h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2>
                        <p>{article.data.description}</p>

                        <ul class="tags" aria-label="标签">
                            {article.data.tags.map((tag) => <li>{tag}</li>)}
                        </ul>
                    </div>

                    <a class="article-arrow" href={`/articles/${article.id}/`} aria-label={`阅读 ${article.data.title}`}>↗</a>
                </article>
            ))}
        </section>
    </main>

    <script is:inline>
        (() => {
            const orb = document.querySelector('[data-article-orb]');
            if (!orb) return;

            const definitions = {
                main: { anchorX: 0, anchorY: 0, limit: 25, pull: .055 },
                small: { anchorX: 84, anchorY: -86, limit: 82, pull: .2 },
                ring: { anchorX: 76, anchorY: 56, limit: 58, pull: .16 },
            };
            const nodes = Array.from(orb.querySelectorAll('[data-orb-node]')).map((element) => {
                const id = element.dataset.orbNode;
                return {
                    id,
                    element,
                    ...definitions[id],
                    x: 0,
                    y: 0,
                    vx: 0,
                    vy: 0,
                    dragging: false,
                    grabX: 0,
                    grabY: 0,
                };
            });
            const main = orb.querySelector('[data-orb-node="main"]');
            let pointer = null;
            let activeNode = null;
            let displayScale = 1;

            const resize = () => {
                displayScale = orb.getBoundingClientRect().width / orb.offsetWidth || 1;
            };

            const setPointer = (event) => {
                const bounds = orb.getBoundingClientRect();
                pointer = {
                    x: ((event.clientX - bounds.left) / displayScale) - (orb.offsetWidth / 2),
                    y: ((event.clientY - bounds.top) / displayScale) - (orb.offsetHeight / 2),
                };
                main.style.setProperty('--orb-light-x', `${50 + (pointer.x / 6)}%`);
                main.style.setProperty('--orb-light-y', `${46 + (pointer.y / 7)}%`);
            };

            const clamp = (x, y, limit) => {
                const distance = Math.hypot(x, y);
                const ratio = distance > limit ? limit / distance : 1;
                return [x * ratio, y * ratio];
            };

            const frame = () => {
                nodes.forEach((node) => {
                    let targetX = 0;
                    let targetY = 0;

                    if (node.dragging && pointer) {
                        targetX = pointer.x - node.anchorX - node.grabX;
                        targetY = pointer.y - node.anchorY - node.grabY;
                    } else if (pointer) {
                        const dx = pointer.x - node.anchorX;
                        const dy = pointer.y - node.anchorY;
                        const distance = Math.hypot(dx, dy);
                        const reach = node.id === 'main' ? 145 : 118;
                        const influence = Math.max(0, 1 - (distance / reach));
                        targetX = dx * node.pull * influence;
                        targetY = dy * node.pull * influence;
                    }

                    [targetX, targetY] = clamp(targetX, targetY, node.limit);
                    const spring = node.dragging ? .2 : .052;
                    const damping = node.dragging ? .72 : .8;
                    node.vx = (node.vx + ((targetX - node.x) * spring)) * damping;
                    node.vy = (node.vy + ((targetY - node.y) * spring)) * damping;
                    node.x += node.vx;
                    node.y += node.vy;
                    node.element.style.transform = `translate3d(${node.x}px, ${node.y}px, 0)`;
                });

                orb.classList.toggle('is-active', Boolean(pointer || activeNode));
                requestAnimationFrame(frame);
            };

            resize();
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            orb.addEventListener('pointerenter', setPointer);
            orb.addEventListener('pointermove', setPointer);
            orb.addEventListener('pointerleave', () => {
                if (!activeNode) pointer = null;
                main.style.setProperty('--orb-light-x', '42%');
                main.style.setProperty('--orb-light-y', '34%');
            });

            nodes.forEach((node) => {
                node.element.addEventListener('pointerdown', (event) => {
                    event.preventDefault();
                    setPointer(event);
                    node.dragging = true;
                    node.grabX = pointer.x - node.anchorX - node.x;
                    node.grabY = pointer.y - node.anchorY - node.y;
                    activeNode = node;
                    node.element.classList.add('is-dragging');
                    node.element.setPointerCapture(event.pointerId);
                });

                const release = (event) => {
                    if (!node.dragging) return;
                    node.dragging = false;
                    activeNode = null;
                    node.element.classList.remove('is-dragging');
                    if (node.element.hasPointerCapture(event.pointerId)) {
                        node.element.releasePointerCapture(event.pointerId);
                    }
                    if (!orb.matches(':hover')) pointer = null;
                };

                node.element.addEventListener('pointerup', release);
                node.element.addEventListener('pointercancel', release);
            });

            window.addEventListener('resize', resize, { passive: true });
            requestAnimationFrame(frame);
        })();
    </script>
</BaseLayout>

<style>
    .articles-page { width: min(920px, calc(100% - 40px)); margin: 0 auto; padding: 54px 0 30px; }

    .page-header { position: relative; display: grid; grid-template-columns: 1fr 240px; align-items: start; min-height: 310px; margin-bottom: 32px; gap: 60px; }
    .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--color-muted); font: 500 .68rem 'DM Mono', monospace; letter-spacing: .14em; }
    .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 0 5px rgb(115 230 255 / 15%); }
    h1 { margin: 24px 0 20px; font-size: clamp(4.2rem, 11vw, 7.4rem); font-weight: 680; line-height: .82; letter-spacing: -.08em; }
    h1 span { position: relative; z-index: 0; }
    h1 span::after { position: absolute; z-index: -1; right: -.06em; bottom: .02em; left: -.02em; height: .28em; border-radius: 999px 45% 999px 52%; background: linear-gradient(90deg, var(--color-cyan), var(--color-accent-soft)); box-shadow: inset 0 2px 2px rgb(255 255 255 / 55%); content: ''; transform: rotate(-1.8deg); }
    .intro { max-width: 560px; margin: 28px 0 0; color: var(--color-muted); font-size: 1rem; line-height: 1.8; }

    .page-orb { position: relative; width: 220px; height: 220px; margin-top: 40px; filter: drop-shadow(0 22px 34px rgb(60 103 93 / 14%)); user-select: none; -webkit-user-select: none; }
    .orb-main { --orb-light-x: 42%; --orb-light-y: 34%; position: absolute; display: grid; z-index: 1; inset: 20px; border-radius: 46% 54% 53% 47% / 52% 43% 57% 48%; background: radial-gradient(circle at var(--orb-light-x) var(--orb-light-y), rgb(255 255 255 / 42%), transparent 28%), linear-gradient(145deg, var(--color-lime), var(--color-cyan)); box-shadow: inset 10px 12px 24px rgb(255 255 255 / 35%), inset -12px -15px 24px rgb(67 122 112 / 12%); cursor: grab; touch-action: none; animation: morph 7s ease-in-out infinite; place-items: center; will-change: transform; }
    .orb-main.is-dragging { cursor: grabbing; }
    .orb-main i { color: #18201e; font-size: 2.2rem; font-style: normal; animation: counter-spin 9s linear infinite; }
    .orb-small { position: absolute; z-index: 3; top: 5px; right: 7px; width: 38px; height: 38px; border: 5px solid var(--color-background); border-radius: 50%; background: var(--color-accent); box-shadow: inset 0 2px 3px rgb(255 255 255 / 32%); cursor: grab; touch-action: none; will-change: transform; }
    .orb-ring { position: absolute; z-index: 2; right: 0; bottom: 20px; width: 68px; height: 68px; border: 1px dashed var(--color-border-strong); border-radius: 50%; cursor: grab; touch-action: none; animation: orb-ring-spin 12s linear infinite; will-change: transform; }
    .orb-small.is-dragging, .orb-ring.is-dragging { z-index: 4; cursor: grabbing; }
    .orb-hint { position: absolute; z-index: 5; right: 16px; bottom: -8px; opacity: 0; color: var(--color-muted); font: 500 .46rem 'DM Mono', monospace; letter-spacing: .11em; pointer-events: none; transition: opacity 220ms ease, transform 480ms var(--ease-spring); transform: translateY(5px); }
    .page-orb.is-active .orb-hint { opacity: .72; transform: translateY(0); }

    .list-heading { display: flex; justify-content: space-between; margin-bottom: 14px; padding: 0 10px; color: var(--color-muted); font: 500 .6rem 'DM Mono', monospace; letter-spacing: .1em; }
    .article-list { display: grid; gap: 18px; }
    .article-card { display: grid; grid-template-columns: 42px 1fr 48px; min-height: 275px; gap: 20px; padding: 32px; overflow: hidden; border-radius: 27px 34px 25px 31px; }
    .article-index { color: var(--color-accent); font: 500 .62rem 'DM Mono', monospace; }
    .article-body { display: flex; flex-direction: column; }
    .meta { display: flex; flex-wrap: wrap; gap: 9px 20px; color: var(--color-muted); font: 400 .6rem 'DM Mono', monospace; letter-spacing: .03em; }
    h2 { max-width: 660px; margin: 28px 0 13px; font-size: clamp(1.45rem, 3.5vw, 2.25rem); line-height: 1.22; letter-spacing: -.045em; }
    h2 a { text-decoration: none; }
    h2 a::after { position: absolute; z-index: 2; inset: 0; content: ''; }
    .article-card p { max-width: 630px; margin: 0; color: var(--color-muted); font-size: .88rem; line-height: 1.75; }
    .tags { display: flex; flex-wrap: wrap; gap: 7px; margin: auto 0 0; padding: 25px 0 0; list-style: none; }
    .tags li { padding: 5px 10px; border: 1px solid var(--color-border); border-radius: 999px; background: rgb(255 255 255 / 22%); color: var(--color-muted); font: 400 .56rem 'DM Mono', monospace; }
    .article-arrow { position: relative; z-index: 3; display: grid; align-self: start; width: 46px; height: 46px; border-radius: 15px 18px 14px 17px; background: var(--color-lime); box-shadow: inset 0 1px 1px rgb(255 255 255 / 72%), 0 9px 18px rgb(83 126 61 / 14%); color: #18201e; text-decoration: none; place-items: center; transition: transform 560ms var(--ease-spring); }
    .article-card:hover .article-arrow { transform: rotate(43deg) scale(1.07); }

    @keyframes morph { 0%, 100% { border-radius: 46% 54% 53% 47% / 52% 43% 57% 48%; } 50% { border-radius: 55% 45% 44% 56% / 45% 56% 44% 55%; } }
    @keyframes counter-spin { to { transform: rotate(-360deg); } }
    @keyframes orb-ring-spin { to { rotate: 360deg; } }

    @media (max-width: 700px) {
        .articles-page { width: min(100% - 24px, 920px); padding-top: 52px; }
        .page-header { grid-template-columns: 1fr; min-height: 360px; margin-bottom: 40px; }
        .page-heading { position: relative; z-index: 2; pointer-events: none; }
        .page-orb { position: absolute; z-index: 1; right: -65px; bottom: -22px; margin-top: 0; opacity: .58; transform: scale(.78); }
        .article-card { grid-template-columns: 1fr auto; min-height: 300px; padding: 25px; }
        .article-index { display: none; }
        .meta { flex-direction: column; }
        .article-arrow { width: 42px; height: 42px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .orb-main, .orb-main i, .orb-ring { animation: none; cursor: default; }
        .orb-small, .orb-ring { cursor: default; }
        .orb-hint { display: none; }
    }
</style>
