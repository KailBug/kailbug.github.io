---
import BaseLayout from '../layouts/BaseLayout.astro';

const focusAreas = [
    'Agent Harness',
    'Tool Use',
    'Context Engineering',
    'Memory Management',
    'Multi Agent',
    'Evaluation & Observability',
    'Agent Infrastructure',
];

const principles = [
    ['01', 'Reliability first', '系统必须能够识别失败、限制风险并安全停止。'],
    ['02', 'Observable by design', '重要状态、工具调用与决策过程应当可以检查。'],
    ['03', 'Simple before scalable', '先建立清晰、可运行的最小系统，再增加复杂度。'],
    ['04', 'Learn by building', '通过可复现的实验和开源实践积累工程知识。'],
];
---

<BaseLayout
    title="About | KailBug"
    description="About KailBug and this Agent Engineering knowledge base."
>
    <main class="about-page">
        <header class="page-header" data-reveal>
            <div>
                <p class="eyebrow"><span></span> ABOUT / KAIL</p>
                <h1>Curious by<br /><em>default.</em></h1>
                <p class="lead">把复杂系统拆开，观察它真正如何工作，再一点点将它重新组装得更可靠。</p>
            </div>

            <div class="identity-orb" aria-hidden="true">
                <div class="portrait-glyph">K</div>
                <span class="orbit-line"><i></i></span>
                <span class="identity-chip">BUILD / LEARN / REPEAT</span>
            </div>
        </header>

        <div class="content-grid">
            <div class="main-content">
                <section class="story-card liquid-shell" data-reveal>
                    <span class="section-index">01 / STORY</span>
                    <h2>About this site</h2>
                    <p>
                        这个网站用于长期记录我对 Harness 工程化的学习、理解和代码实践，
                        也是记录个人想法的综合主页，并不单纯侧重技术分享。
                    </p>
                    <p>
                        工程技术内容不限于 Agent runtime 如何运行、使用工具、管理上下文与记忆，
                        以及如何对长期运行的 Agent System 进行评估、观测和约束，
                        偶尔也会发布一些工程之外的理解。
                    </p>
                </section>

                <section class="principles-section" data-reveal>
                    <div class="section-heading">
                        <span class="section-index">02 / PRINCIPLES</span>
                        <h2>How I like to build.</h2>
                    </div>

                    <ul class="principles">
                        {principles.map(([index, title, description]) => (
                            <li class="liquid-shell" data-tilt>
                                <span class="principle-index">{index}</span>
                                <strong>{title}</strong>
                                <p>{description}</p>
                            </li>
                        ))}
                    </ul>
                </section>

                <section class="connect-card liquid-shell" data-reveal>
                    <div>
                        <span class="section-index">03 / CONNECT</span>
                        <h2>Find me elsewhere.</h2>
                        <p>你可以通过 GitHub 查看我的项目和公开活动，也可以在 X 上关注我的动态。</p>
                    </div>
                    <div class="social-links">
                        <a class="magnetic" href="https://github.com/KailBug" target="_blank" rel="noreferrer" data-magnetic>
                            GitHub <span>↗</span>
                        </a>
                        <a class="magnetic" href="https://x.com/KailTian" target="_blank" rel="noreferrer" data-magnetic>
                            X / Twitter <span>↗</span>
                        </a>
                    </div>
                </section>
            </div>

            <aside class="liquid-shell" data-reveal>
                <div class="aside-top">
                    <p class="aside-title">FOCUS AREAS</p>
                    <span>{String(focusAreas.length).padStart(2, '0')}</span>
                </div>
                <ul>{focusAreas.map((area, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{area}</li>)}</ul>
                <div class="aside-gem" aria-hidden="true"><span></span><i></i></div>
            </aside>
        </div>
    </main>
</BaseLayout>

<style>
    .about-page { width: min(1040px, calc(100% - 40px)); margin: 0 auto; padding: 54px 0 30px; }
    .page-header { display: grid; grid-template-columns: 1fr 330px; align-items: start; min-height: 500px; gap: 70px; margin-bottom: 96px; }
    .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--color-muted); font: 500 .68rem 'DM Mono', monospace; letter-spacing: .14em; }
    .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--color-lime); box-shadow: 0 0 0 5px rgb(185 243 106 / 16%); }
    h1 { margin: 25px 0 28px; font-size: clamp(4rem, 9vw, 7rem); font-weight: 670; line-height: .88; letter-spacing: -.075em; }
    h1 em { position: relative; z-index: 0; font-style: normal; }
    h1 em::after { position: absolute; z-index: -1; right: -.09em; bottom: .02em; left: -.04em; height: .3em; border-radius: 999px 50% 999px 46%; background: linear-gradient(90deg, var(--color-lime), var(--color-cyan)); box-shadow: inset 0 2px 2px rgb(255 255 255 / 60%); content: ''; transform: rotate(-2deg); }
    .lead { max-width: 610px; margin: 0; color: var(--color-muted); font-size: 1rem; line-height: 1.85; }

    .identity-orb { position: relative; width: 310px; height: 310px; }
    .portrait-glyph { position: absolute; display: grid; inset: 34px; border-radius: 42% 58% 49% 51% / 55% 44% 56% 45%; background: linear-gradient(145deg, var(--color-accent), #888aff); box-shadow: 0 30px 55px rgb(91 92 240 / 22%), inset 12px 14px 25px rgb(255 255 255 / 18%), inset -10px -14px 25px rgb(41 42 151 / 20%); color: white; font-size: 6.4rem; font-weight: 750; letter-spacing: -.1em; animation: morph 8s ease-in-out infinite; place-items: center; }
    .orbit-line { position: absolute; inset: 8px; border: 1px dashed var(--color-border-strong); border-radius: 50%; animation: spin 17s linear infinite; }
    .orbit-line i { position: absolute; top: 31px; right: 29px; width: 19px; height: 19px; border: 4px solid var(--color-background); border-radius: 50%; background: var(--color-lime); }
    .identity-chip { position: absolute; right: -5px; bottom: 18px; padding: 10px 13px; border: 1px solid rgb(255 255 255 / 52%); border-radius: 12px 15px 11px 14px; background: var(--color-surface); box-shadow: var(--shadow-float); color: var(--color-muted); font: 500 .55rem 'DM Mono', monospace; letter-spacing: .08em; backdrop-filter: blur(14px); transform: rotate(4deg); }

    .content-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; align-items: start; gap: 28px; }
    .main-content { display: grid; gap: 82px; }
    .section-index, .aside-title { color: var(--color-accent); font: 500 .62rem 'DM Mono', monospace; letter-spacing: .11em; }
    h2 { margin: 17px 0 22px; font-size: clamp(1.8rem, 4vw, 3.1rem); font-weight: 650; line-height: 1.08; letter-spacing: -.055em; }
    .story-card { padding: clamp(30px, 6vw, 54px); border-radius: 28px 36px 26px 32px; }
    .story-card p, .connect-card p { color: var(--color-muted); font-size: .96rem; line-height: 1.9; }
    .story-card p:last-child { margin-bottom: 0; }

    .section-heading { margin-bottom: 27px; }
    .principles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin: 0; padding: 0; list-style: none; }
    .principles li { display: grid; grid-template-columns: 1fr; min-height: 210px; padding: 26px; overflow: hidden; border-radius: 23px 29px 22px 27px; }
    .principle-index { color: var(--color-muted); font: 500 .58rem 'DM Mono', monospace; }
    .principles strong { grid-row: 2; align-self: end; margin-top: 36px; font-size: 1rem; letter-spacing: -.02em; }
    .principles p { grid-row: 3; grid-column: 1 / -1; margin: 9px 0 0; color: var(--color-muted); font-size: .78rem; line-height: 1.7; }

    .connect-card { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 40px; padding: 38px; border-radius: 27px 34px 25px 31px; }
    .connect-card h2 { font-size: 2.2rem; }
    .connect-card p { max-width: 500px; margin-bottom: 0; font-size: .84rem; }
    .social-links { display: grid; gap: 9px; }
    .social-links a { display: flex; align-items: center; justify-content: space-between; min-width: 145px; gap: 18px; padding: 12px 13px 12px 16px; border: 1px solid var(--color-border); border-radius: 14px 17px 13px 16px; background: rgb(255 255 255 / 22%); color: var(--color-muted); font-size: .72rem; font-weight: 700; text-decoration: none; }
    .social-links a span { display: grid; width: 26px; height: 26px; border-radius: 9px; background: var(--color-lime); color: #18201e; place-items: center; transition: transform 500ms var(--ease-spring); }
    .social-links a:hover span { transform: rotate(42deg); }

    aside { position: sticky; top: 22px; overflow: hidden; padding: 25px; border-radius: 25px 31px 23px 28px; }
    .aside-top { display: flex; align-items: center; justify-content: space-between; }
    .aside-top p { margin: 0; }
    .aside-top > span { color: var(--color-muted); font: 500 .58rem 'DM Mono', monospace; }
    aside ul { display: grid; gap: 0; margin: 22px 0 98px; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
    aside li { display: grid; grid-template-columns: 26px 1fr; padding: 12px 0; border-bottom: 1px solid var(--color-border); color: var(--color-muted); font-size: .7rem; line-height: 1.4; }
    aside li span { font: 400 .52rem 'DM Mono', monospace; }
    .aside-gem { position: absolute; right: -28px; bottom: -46px; width: 135px; height: 135px; border-radius: 44% 56% 49% 51%; background: linear-gradient(145deg, var(--color-lime), var(--color-cyan)); box-shadow: inset 8px 10px 15px rgb(255 255 255 / 42%); transform: rotate(-15deg); }
    .aside-gem span { position: absolute; top: 26px; left: 29px; width: 42px; height: 42px; border: 8px solid #18201e; border-top-color: transparent; border-radius: 50%; transform: rotate(22deg); }
    .aside-gem i { position: absolute; top: 11px; left: 18px; width: 15px; height: 15px; border: 3px solid var(--color-surface-solid); border-radius: 50%; background: var(--color-accent); }

    @keyframes morph { 0%, 100% { border-radius: 42% 58% 49% 51% / 55% 44% 56% 45%; transform: rotate(-2deg); } 50% { border-radius: 55% 45% 57% 43% / 43% 58% 42% 57%; transform: rotate(4deg); } }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 850px) {
        .page-header { grid-template-columns: 1fr; min-height: 650px; }
        .identity-orb { position: absolute; z-index: -1; right: -60px; bottom: 10px; opacity: .65; transform: scale(.85); }
        .content-grid { grid-template-columns: 1fr; }
        aside { position: relative; top: auto; }
    }

    @media (max-width: 600px) {
        .about-page { width: min(100% - 24px, 1040px); padding-top: 52px; }
        .page-header { min-height: 560px; margin-bottom: 70px; }
        h1 { font-size: clamp(4rem, 18vw, 6rem); }
        .identity-orb { right: -100px; bottom: -10px; transform: scale(.65); }
        .main-content { gap: 66px; }
        .principles { grid-template-columns: 1fr; }
        .connect-card { grid-template-columns: 1fr; align-items: start; padding: 28px; }
        .social-links { grid-template-columns: 1fr; }
    }
</style>
