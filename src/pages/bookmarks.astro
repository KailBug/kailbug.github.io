---
import BaseLayout from '../layouts/BaseLayout.astro';
import bookmarks from '../data/bookmarks.json';

const rotations = [-2.4, 1.3, -1.1, 2, -.7, 1.7, -1.8, .8, -1.4, 2.2];
---

<BaseLayout
    title="Bookmarks | KailBug"
    description="收藏在阅读过程中的句子、作者与出处。"
>
    <main class="bookmarks-page">
        <header class="bookmarks-intro" data-reveal>
            <div>
                <p class="eyebrow"><span></span> READING FRAGMENTS</p>
                <h1>Bookmarks<span>.</span></h1>
            </div>
            <p class="instructions">
                悬停任意卡牌，翻开一段被收藏的文字。<br />移开后，它会回到牌堆并等待下一次相遇。
            </p>
        </header>

        <section class="card-stage" aria-label="随机名言卡牌" data-reveal>
            <div class="card-field" data-bookmark-field>
                {bookmarks.map((_, index) => (
                    <button
                        class:list={['card-slot', index < 10 ? 'row-top' : 'row-bottom']}
                        type="button"
                        aria-label="翻开随机书签"
                        data-card-slot
                        style={`grid-column: ${(index % 10) + 1}; --rest-rotate: ${rotations[index % rotations.length]}deg;`}
                    >
                        <span class="bookmark-card">
                            <span class="card-face card-back" aria-hidden="true">
                                <span class="back-pattern">
                                    <i></i><i></i><i></i>
                                </span>
                                <span class="back-glyph">K</span>
                                <span class="back-orbit"></span>
                            </span>

                            <span class="card-face card-front">
                                <span class="quote-window">
                                    <span class="quote-content"></span>
                                    <span class="quote-scroll-cue" aria-hidden="true">SCROLL</span>
                                </span>
                                <span class="quote-source">
                                    <span class="book-name"></span>
                                    <span class="author-name"></span>
                                </span>
                            </span>
                        </span>
                    </button>
                ))}
            </div>
        </section>

        <p class="touch-hint" data-reveal>轻触卡牌翻开，再次轻触或点击空白处收回。</p>
    </main>

    <script is:inline define:vars={{ bookmarks }}>
        (() => {
            const field = document.querySelector('[data-bookmark-field]');
            if (!field || !Array.isArray(bookmarks) || bookmarks.length === 0) return;

            const slots = [...field.querySelectorAll('[data-card-slot]')];
            const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
            const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
            const recentBySlot = new WeakMap();
            const HOVER_DELAY = reducedMotion ? 0 : 150;
            const RESET_DELAY = reducedMotion ? 20 : 680;
            let deck = [];
            let lastDrawnId = null;
            let activeSlot = null;
            let layoutFrame;

            const shuffle = (items) => {
                const result = [...items];
                for (let index = result.length - 1; index > 0; index -= 1) {
                    const swapIndex = Math.floor(Math.random() * (index + 1));
                    [result[index], result[swapIndex]] = [result[swapIndex], result[index]];
                }
                return result;
            };

            const refillDeck = () => {
                deck = shuffle(bookmarks);
                if (deck.length > 1 && deck[0]?.id === lastDrawnId) {
                    [deck[0], deck[1]] = [deck[1], deck[0]];
                }
            };

            const drawFor = (slot) => {
                if (deck.length === 0) refillDeck();
                const recent = recentBySlot.get(slot) || [];
                let quoteIndex = deck.findIndex((quote) => !recent.includes(quote.id));

                if (quoteIndex < 0) {
                    refillDeck();
                    quoteIndex = deck.findIndex((quote) => !recent.includes(quote.id));
                }

                if (quoteIndex < 0) quoteIndex = 0;
                const [quote] = deck.splice(quoteIndex, 1);
                lastDrawnId = quote.id;
                recentBySlot.set(slot, [quote.id, ...recent.filter((id) => id !== quote.id)].slice(0, 4));
                return quote;
            };

            const updateOverflow = (slot) => {
                const content = slot.querySelector('.quote-content');
                const front = slot.querySelector('.card-front');
                const bottomPadding = Number.parseFloat(getComputedStyle(content).paddingBottom) || 0;
                const scrollable = content.scrollHeight - bottomPadding > content.clientHeight + 2;
                const atEnd = !scrollable || Math.ceil(content.scrollTop + content.clientHeight) >= content.scrollHeight - 2;

                front.classList.toggle('is-scrollable', scrollable);
                front.classList.toggle('is-scrolled-end', atEnd);
                front.classList.toggle('has-scrolled', content.scrollTop > 4);
            };

            const renderQuote = (slot, quote) => {
                const content = slot.querySelector('.quote-content');
                const book = slot.querySelector('.book-name');
                const author = slot.querySelector('.author-name');
                const front = slot.querySelector('.card-front');

                const length = Array.from(quote.content).length;
                content.scrollTop = 0;
                content.textContent = `“${quote.content}”`;
                book.textContent = quote.book ? `《${quote.book}》` : '';
                book.hidden = !quote.book;
                author.textContent = quote.author || '';
                author.hidden = !quote.author;
                front.dataset.length = length > 130 ? 'xlong' : length > 72 ? 'long' : length > 40 ? 'medium' : 'short';
                front.classList.remove('is-scrollable', 'is-scrolled-end', 'has-scrolled');
                slot.setAttribute('aria-label', `${quote.content}${quote.author ? `，${quote.author}` : ''}${quote.book ? `，《${quote.book}》` : ''}`);
                requestAnimationFrame(() => updateOverflow(slot));
            };

            const clearQuote = (slot) => {
                const content = slot.querySelector('.quote-content');
                const front = slot.querySelector('.card-front');
                content.scrollTop = 0;
                content.textContent = '';
                slot.querySelector('.book-name').textContent = '';
                slot.querySelector('.author-name').textContent = '';
                front.classList.remove('is-scrollable', 'is-scrolled-end', 'has-scrolled');
                delete front.dataset.length;
                slot.setAttribute('aria-label', '翻开随机书签');
            };

            const reveal = (slot) => {
                clearTimeout(slot._revealTimer);
                clearTimeout(slot._resetTimer);
                if (activeSlot && activeSlot !== slot) conceal(activeSlot);

                slot._revealTimer = setTimeout(() => {
                    renderQuote(slot, drawFor(slot));
                    slot.classList.add('is-active');
                    slot.setAttribute('aria-expanded', 'true');
                    activeSlot = slot;
                }, HOVER_DELAY);
            };

            const conceal = (slot) => {
                clearTimeout(slot._revealTimer);
                clearTimeout(slot._resetTimer);
                slot.classList.remove('is-active');
                slot.setAttribute('aria-expanded', 'false');
                if (activeSlot === slot) activeSlot = null;
                slot._resetTimer = setTimeout(() => clearQuote(slot), RESET_DELAY);
            };

            const layoutCards = () => {
                const availableWidth = field.parentElement.clientWidth;
                const gap = availableWidth < 640 ? 6 : 10;
                const targetWidth = availableWidth < 640 ? 124 : availableWidth < 940 ? 148 : availableWidth < 1500 ? 168 : 180;
                const columns = Math.min(10, Math.max(3, Math.floor((availableWidth + gap) / (targetWidth + gap))));
                const visibleCount = Math.min(slots.length, columns * 2);
                const cardWidth = Math.min(208, (availableWidth - gap * (columns - 1)) / columns);

                field.style.setProperty('--columns', columns);
                field.style.setProperty('--card-width', `${cardWidth}px`);
                field.style.setProperty('--card-gap', `${gap}px`);

                slots.forEach((slot, index) => {
                    const visible = index < visibleCount;
                    slot.hidden = !visible;
                    if (!visible) {
                        conceal(slot);
                        return;
                    }
                    const row = index < columns ? 'top' : 'bottom';
                    slot.classList.toggle('row-top', row === 'top');
                    slot.classList.toggle('row-bottom', row === 'bottom');
                    slot.style.gridColumn = String((index % columns) + 1);
                    slot.style.gridRow = row === 'top' ? '1' : '2';
                });

                requestAnimationFrame(() => {
                    slots.filter((slot) => slot.classList.contains('is-active')).forEach(updateOverflow);
                });
            };

            slots.forEach((slot) => {
                slot.setAttribute('aria-expanded', 'false');
                const content = slot.querySelector('.quote-content');

                content.addEventListener('scroll', () => updateOverflow(slot), { passive: true });
                slot.addEventListener('wheel', (event) => {
                    if (!slot.classList.contains('is-active')) return;
                    const maxScroll = content.scrollHeight - content.clientHeight;
                    const canMoveDown = event.deltaY > 0 && content.scrollTop < maxScroll - 1;
                    const canMoveUp = event.deltaY < 0 && content.scrollTop > 1;
                    if (!canMoveDown && !canMoveUp) return;
                    event.preventDefault();
                    event.stopPropagation();
                    content.scrollTop = Math.max(0, Math.min(maxScroll, content.scrollTop + event.deltaY));
                }, { passive: false });

                slot.addEventListener('pointerenter', () => {
                    if (finePointer.matches) reveal(slot);
                });
                slot.addEventListener('pointerleave', () => {
                    if (finePointer.matches) conceal(slot);
                });
                slot.addEventListener('focus', () => reveal(slot));
                slot.addEventListener('blur', () => conceal(slot));
                slot.addEventListener('click', (event) => {
                    if (finePointer.matches) return;
                    event.stopPropagation();
                    slot.classList.contains('is-active') ? conceal(slot) : reveal(slot);
                });
                slot.addEventListener('keydown', (event) => {
                    if (!slot.classList.contains('is-active')) return;
                    const distance = event.key === 'PageDown' || event.key === 'PageUp' ? content.clientHeight * .72 : 34;
                    const direction = event.key === 'ArrowDown' || event.key === 'PageDown' ? 1 : event.key === 'ArrowUp' || event.key === 'PageUp' ? -1 : 0;
                    if (!direction) return;
                    event.preventDefault();
                    content.scrollBy({ top: distance * direction, behavior: reducedMotion ? 'auto' : 'smooth' });
                });
            });

            document.addEventListener('click', (event) => {
                if (!finePointer.matches && activeSlot && !activeSlot.contains(event.target)) conceal(activeSlot);
            });

            layoutCards();
            addEventListener('resize', () => {
                cancelAnimationFrame(layoutFrame);
                layoutFrame = requestAnimationFrame(layoutCards);
            }, { passive: true });
        })();
    </script>
</BaseLayout>

<style>
    .bookmarks-page {
        display: flex;
        flex-direction: column;
        min-height: calc(100svh - 104px);
        padding: 46px 0 64px;
    }

    .bookmarks-intro {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        width: var(--page-width);
        gap: 44px;
        margin: 0 auto 34px;
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 15px;
        color: var(--color-muted);
        font: 500 .65rem 'DM Mono', monospace;
        letter-spacing: .13em;
    }

    .eyebrow span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-lime);
        box-shadow: 0 0 0 5px rgb(185 243 106 / 16%);
    }

    h1 {
        margin: 0;
        font-size: clamp(3.4rem, 7vw, 6rem);
        font-weight: 680;
        line-height: .9;
        letter-spacing: -.075em;
    }

    h1 span { color: var(--color-accent); }

    .instructions {
        max-width: 390px;
        margin: 0 0 4px;
        color: var(--color-muted);
        font-size: .8rem;
        line-height: 1.8;
        text-align: right;
    }

    .card-stage {
        display: grid;
        flex: 1;
        width: min(1600px, calc(100% - 28px));
        min-width: 0;
        min-height: 370px;
        margin: 0 auto;
        padding: clamp(30px, 5vh, 58px) 0;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        place-items: center;
    }

    .card-field {
        --columns: 10;
        --card-width: 176px;
        --card-height: calc(var(--card-width) * 1.42);
        --card-gap: 10px;
        display: grid;
        grid-template-columns: repeat(var(--columns), var(--card-width));
        grid-template-rows: var(--card-height) calc(var(--card-height) * .33);
        justify-content: center;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        height: calc(var(--card-height) * 1.33);
        column-gap: var(--card-gap);
        perspective: 1500px;
        isolation: isolate;
    }

    .card-slot {
        position: relative;
        width: var(--card-width);
        height: var(--card-height);
        padding: 0;
        border: 0;
        outline: none;
        background: transparent;
        cursor: crosshair;
        transform: translateZ(0);
    }

    .card-slot[hidden] { display: none; }
    .card-slot.row-top { z-index: 5; }
    .card-slot.row-bottom { z-index: 2; transform: translateY(calc(var(--card-height) * -.67)); }
    .card-slot.is-active { z-index: 100; }

    .bookmark-card {
        position: absolute;
        inset: 0;
        display: block;
        border-radius: 18px 23px 17px 21px;
        box-shadow:
            0 2px 2px rgb(var(--color-shadow) / 7%),
            0 10px 24px rgb(var(--color-shadow) / 12%),
            0 28px 52px rgb(var(--color-shadow) / 9%);
        transform: rotateZ(var(--rest-rotate, 0deg));
        transition: transform 680ms cubic-bezier(.2, 1.35, .32, 1), box-shadow 420ms ease;
        transform-style: preserve-3d;
        will-change: transform;
    }

    .row-top { --card-lift: -7%; }
    .row-bottom { --card-lift: -18%; }

    .card-slot.is-active .bookmark-card {
        box-shadow:
            0 4px 4px rgb(var(--color-shadow) / 8%),
            0 22px 42px rgb(var(--color-shadow) / 18%),
            0 55px 90px rgb(var(--color-shadow) / 14%);
        transform: translateY(var(--card-lift)) rotateZ(0deg) rotateY(180deg) scale(1.055);
    }

    .card-slot:focus-visible .bookmark-card {
        outline: 3px solid var(--color-accent);
        outline-offset: 5px;
    }

    .card-face {
        position: absolute;
        display: flex;
        overflow: hidden;
        inset: 0;
        border: 1px solid rgb(255 255 255 / 45%);
        border-radius: inherit;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .card-back {
        align-items: center;
        justify-content: center;
        background:
            radial-gradient(circle at 78% 20%, rgb(185 243 106 / 78%) 0 7%, transparent 7.5%),
            radial-gradient(circle at 15% 85%, rgb(115 230 255 / 45%), transparent 30%),
            linear-gradient(145deg, #4d4fe0, #7779fb 52%, #5153d9);
        box-shadow: inset 0 1px 1px rgb(255 255 255 / 35%), inset -12px -15px 30px rgb(29 30 113 / 15%);
    }

    .card-back::before {
        position: absolute;
        inset: 10px;
        border: 1px solid rgb(255 255 255 / 25%);
        border-radius: 13px 18px 12px 16px;
        content: '';
    }

    .card-back::after {
        position: absolute;
        inset: 22px;
        opacity: .17;
        background: repeating-radial-gradient(circle at center, transparent 0 11px, white 12px 13px);
        content: '';
        transform: rotate(-8deg);
    }

    .back-pattern {
        position: absolute;
        inset: 0;
        filter: url('#goo');
    }

    .back-pattern i {
        position: absolute;
        display: block;
        border-radius: 50%;
        background: rgb(255 255 255 / 15%);
    }

    .back-pattern i:nth-child(1) { top: 21%; left: 18%; width: 38%; aspect-ratio: 1; }
    .back-pattern i:nth-child(2) { right: 13%; bottom: 18%; width: 45%; aspect-ratio: 1; }
    .back-pattern i:nth-child(3) { top: 43%; left: 42%; width: 24%; aspect-ratio: 1; }

    .back-glyph {
        position: relative;
        z-index: 2;
        display: grid;
        width: 46%;
        aspect-ratio: 1;
        border: 1px solid rgb(255 255 255 / 38%);
        border-radius: 40% 60% 46% 54% / 55% 43% 57% 45%;
        background: rgb(255 255 255 / 13%);
        box-shadow: inset 0 1px 2px rgb(255 255 255 / 25%), 0 16px 28px rgb(28 30 115 / 18%);
        color: white;
        font-size: clamp(2rem, 3vw, 3.4rem);
        font-weight: 750;
        place-items: center;
        backdrop-filter: blur(8px);
    }

    .back-orbit {
        position: absolute;
        z-index: 3;
        width: 60%;
        aspect-ratio: 1;
        border: 1px dashed rgb(255 255 255 / 30%);
        border-radius: 50%;
        transform: rotate(-18deg);
    }

    .card-front {
        align-items: stretch;
        justify-content: space-between;
        flex-direction: column;
        padding: clamp(16px, calc(var(--card-width) * .12), 25px);
        background:
            radial-gradient(circle at 86% 13%, rgb(185 243 106 / 27%), transparent 28%),
            radial-gradient(circle at 8% 90%, rgb(115 230 255 / 18%), transparent 34%),
            linear-gradient(145deg, rgb(255 255 255 / 96%), rgb(247 249 245 / 92%));
        box-shadow: inset 0 1px 1px rgb(255 255 255 / 92%);
        color: #18201e;
        text-align: left;
        transform: rotateY(180deg);
    }

    .card-front::before {
        position: absolute;
        top: 19px;
        right: 19px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-lime);
        box-shadow: 0 0 0 5px rgb(185 243 106 / 18%);
        content: '';
    }

    .quote-window {
        position: relative;
        z-index: 1;
        display: block;
        min-height: 0;
        flex: 1 1 0;
        overflow: hidden;
    }

    .quote-window::after {
        position: absolute;
        right: 5px;
        bottom: 0;
        left: 0;
        z-index: 2;
        height: 44px;
        opacity: 0;
        background: linear-gradient(to bottom, transparent, rgb(247 249 245 / 98%) 82%);
        content: '';
        pointer-events: none;
        transition: opacity 180ms ease;
    }

    .card-front.is-scrollable:not(.is-scrolled-end) .quote-window::after { opacity: 1; }

    .quote-content {
        display: block;
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        overflow-y: auto;
        padding-top: 12%;
        padding-right: 7px;
        scrollbar-color: transparent transparent;
        scrollbar-gutter: stable;
        scrollbar-width: thin;
        font-size: clamp(.82rem, 1.2vw, 1.05rem);
        font-weight: 680;
        line-height: 1.65;
        letter-spacing: -.025em;
        -webkit-overflow-scrolling: touch;
    }

    .quote-content::-webkit-scrollbar { width: 3px; }
    .quote-content::-webkit-scrollbar-track { background: transparent; }
    .quote-content::-webkit-scrollbar-thumb { border-radius: 999px; background: transparent; }
    .card-slot.is-active:hover .quote-content, .card-slot:focus-visible .quote-content { scrollbar-color: rgb(24 32 30 / 24%) transparent; }
    .card-slot.is-active:hover .quote-content::-webkit-scrollbar-thumb, .card-slot:focus-visible .quote-content::-webkit-scrollbar-thumb { background: rgb(24 32 30 / 24%); }

    .card-front[data-length='medium'] .quote-content { padding-top: 8%; font-size: clamp(.74rem, 1vw, .9rem); line-height: 1.62; }
    .card-front[data-length='long'] .quote-content { padding-top: 4%; font-size: clamp(.66rem, .9vw, .78rem); line-height: 1.58; }
    .card-front[data-length='xlong'] .quote-content { padding-top: 0; font-size: clamp(.61rem, .82vw, .7rem); line-height: 1.55; }
    .card-front.is-scrollable .quote-content { padding-bottom: 30px; }

    .quote-scroll-cue {
        position: absolute;
        right: 12px;
        bottom: 6px;
        z-index: 3;
        opacity: 0;
        color: #68736f;
        font: 500 .43rem 'DM Mono', monospace;
        letter-spacing: .11em;
        pointer-events: none;
        transition: opacity 180ms ease, transform 320ms var(--ease-spring);
        transform: translateY(3px);
    }

    .card-front.is-scrollable:not(.is-scrolled-end):not(.has-scrolled) .quote-scroll-cue { opacity: .72; transform: translateY(0); }

    .quote-source {
        position: relative;
        z-index: 1;
        display: grid;
        flex: 0 0 auto;
        gap: 6px;
        padding-top: 14px;
        border-top: 1px solid rgb(24 32 30 / 12%);
    }

    .book-name { font-size: .64rem; font-weight: 720; }
    .author-name { color: #68736f; font: 400 .56rem 'DM Mono', monospace; }

    .touch-hint {
        display: none;
        width: var(--page-width);
        margin: 20px auto 0;
        color: var(--color-muted);
        font-size: .7rem;
        text-align: center;
    }

    @media (max-width: 760px) {
        .bookmarks-page { min-height: calc(100svh - 148px); padding: 38px 0 48px; }
        .bookmarks-intro { align-items: flex-start; flex-direction: column; gap: 20px; margin-bottom: 28px; }
        .instructions { max-width: 340px; text-align: left; }
        .card-stage { width: calc(100% - 12px); min-height: 300px; padding: 36px 0; }
        .touch-hint { display: block; }
        .card-front { padding: 16px; }
        .quote-content { font-size: .72rem; }
        .card-front[data-length='medium'] .quote-content { font-size: .68rem; }
        .card-front[data-length='long'] .quote-content { font-size: .62rem; }
        .card-front[data-length='xlong'] .quote-content { font-size: .58rem; }
        .book-name { font-size: .56rem; }
        .author-name { font-size: .5rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .bookmark-card { transition-duration: .01ms; }
    }
</style>
