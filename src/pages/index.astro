---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (
	await getCollection('blog', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredArticles = articles
	.filter(({ data }) => data.featured)
	.slice(0, 3);

const latestArticles = articles.slice(0, 4);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<BaseLayout
	title="KailBug — Agent Engineering"
	description="Writing about Agent Runtime, Harness, Tool Use, Memory, Evaluation and Agent Infrastructure."
>
	<main class="home">
		<section class="hero">
			<div class="hero-copy">
				<p class="eyebrow">AGENT ENGINEERING / SOFTWARE ENGINEERING</p>

				<h1>Building reliable<br />AI agents.</h1>

				<p class="intro">
					Writing about Agent Runtime, Harness, Tool Use,
					Memory, Evaluation and Agent Infrastructure.
				</p>

				<div class="actions">
					<a class="primary-action" href="/articles/">
						Browse Articles
					</a>

					<a
						class="secondary-action"
						href="https://github.com/KailBug"
						target="_blank"
						rel="noreferrer"
					>
						GitHub ↗
					</a>
				</div>
			</div>

		</section>

		<section class="content-section">
			<div class="section-heading">
				<div>
					<p class="section-label">SELECTED WRITING</p>
					<h2>Featured Articles</h2>
				</div>

				<a href="/articles/">View all →</a>
			</div>

			<div class="article-grid">
				{
					featuredArticles.map((article) => (
						<article class="article-card">
							<div class="article-meta">
								<span>{article.data.category}</span>
								<time datetime={article.data.date.toISOString()}>
									{dateFormatter.format(article.data.date)}
								</time>
							</div>

							<h3>
								<a href={`/articles/${article.id}/`}>
									{article.data.title}
								</a>
							</h3>

							<p>{article.data.description}</p>

							<ul class="tags" aria-label="标签">
								{article.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<section class="content-section">
			<div class="section-heading">
				<div>
					<p class="section-label">RECENTLY PUBLISHED</p>
					<h2>Latest Articles</h2>
				</div>
			</div>

			<div class="latest-list">
				{
					latestArticles.map((article) => (
						<a
							class="latest-item"
							href={`/articles/${article.id}/`}
						>
							<div>
                <span class="latest-category">
                  {article.data.category}
                </span>
								<h3>{article.data.title}</h3>
							</div>

							<time datetime={article.data.date.toISOString()}>
								{dateFormatter.format(article.data.date)}
							</time>
						</a>
					))
				}
			</div>
		</section>

	</main>
</BaseLayout>

<style>
	.home {
		width: min(1100px, calc(100% - 40px));
		margin: 0 auto;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		min-height: 620px;
		padding: 96px 0;
	}

	.eyebrow,
	.section-label {
		color: var(--color-accent);
		font-size: 0.78rem;
		font-weight: 750;
		letter-spacing: 0.14em;
	}

	h1 {
		margin: 20px 0 24px;
		font-size: clamp(3.5rem, 8vw, 7rem);
		line-height: 0.95;
		letter-spacing: -0.065em;
	}

	.intro {
		max-width: 650px;
		margin: 0;
		color: var(--color-muted);
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.75;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 36px;
	}

	.actions a {
		padding: 12px 18px;
		border-radius: 9px;
		font-weight: 650;
		text-decoration: none;
	}

	.primary-action {
		background: var(--color-text);
		color: white;
	}

	.primary-action:hover {
		background: var(--color-accent);
	}

	.secondary-action {
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.content-section {
		padding: 72px 0;
		border-top: 1px solid var(--color-border);
	}

	.content-section:last-child {
		padding-bottom: 0;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 32px;
	}

	.section-heading h2 {
		margin: 8px 0 0;
		font-size: clamp(2rem, 4vw, 3rem);
		letter-spacing: -0.04em;
	}

	.section-heading > a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.section-heading > a:hover {
		color: var(--color-accent);
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.article-card {
		padding: 26px;
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background: var(--color-surface);
	}

	.article-meta {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		color: #68758a;
		font-size: 0.8rem;
	}

	.article-card h3 {
		margin: 18px 0 12px;
		font-size: 1.25rem;
		line-height: 1.4;
	}

	.article-card h3 a {
		text-decoration: none;
	}

	.article-card h3 a:hover {
		color: var(--color-accent);
	}

	.article-card > p {
		color: var(--color-muted);
		line-height: 1.65;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin: 20px 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 4px 9px;
		border-radius: 999px;
		background: #eef4ff;
		color: #315a9d;
		font-size: 0.75rem;
	}

	.latest-list {
		border-top: 1px solid var(--color-border);
	}

	.latest-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding: 24px 4px;
		border-bottom: 1px solid var(--color-border);
		text-decoration: none;
	}

	.latest-item:hover h3 {
		color: var(--color-accent);
	}

	.latest-item h3 {
		margin: 6px 0 0;
		font-size: 1.15rem;
	}

	.latest-category,
	.latest-item time {
		color: var(--color-muted);
		font-size: 0.8rem;
	}

	@media (max-width: 820px) {
		.hero {
			min-height: auto;
			padding: 72px 0;
		}

		.article-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.section-heading,
		.latest-item {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
