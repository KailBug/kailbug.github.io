---
import BaseLayout from '../layouts/BaseLayout.astro';

const systemLayers = [
    {
        id: 'runtime',
        tab: 'Runtime',
        index: '01',
        title: 'Keep the loop moving.',
        description: '识别停滞、压缩失败、切换策略，让长时间运行的 Agent 仍然持续产生有效进展。',
        signals: ['Loop detection', 'Budget control', 'Recovery policy'],
        color: 'lime',
    },
    {
        id: 'context',
        tab: 'Context',
        index: '02',
        title: 'Give every token a job.',
        description: '围绕任务状态组织上下文与记忆，保留关键证据，同时避免历史信息淹没真正的决策。',
        signals: ['State compression', 'Memory layers', 'Evidence routing'],
        color: 'cyan',
    },
    {
        id: 'evaluation',
        tab: 'Evaluation',
        index: '03',
        title: 'Make progress observable.',
        description: '用清晰的轨迹、指标和回归实验判断 Agent 是在解决问题，还是只是在制造更多动作。',
        signals: ['Trace review', 'Progress metrics', 'Regression suites'],
        color: 'violet',
    },
];
---

<BaseLayout
    title="KailBug — Agent Engineering"
    description="Writing about Agent Runtime, Harness, Tool Use, Memory, Evaluation and Agent Infrastructure."
>
    <main class="home">
        <section class="hero">
            <div class="hero-copy" data-reveal>
                <p class="eyebrow"><span></span> AGENT ENGINEERING / FIELD NOTES</p>

                <h1>
                    Building reliable
                    <span class="liquid-title">AI agents.<i aria-hidden="true"></i></span>
                </h1>

                <p class="intro">
                    Writing about Agent Runtime, Harness, Tool Use, Memory,
                    Evaluation and the infrastructure behind durable AI systems.
                </p>

                <div class="actions">
                    <a class="primary-action magnetic" href="/articles/" data-magnetic>
                        <span>Browse Articles</span>
                        <span class="action-orb" aria-hidden="true">↗</span>
                    </a>

                    <a
                        class="secondary-action magnetic"
                        href="https://github.com/KailBug"
                        target="_blank"
                        rel="noreferrer"
                        data-magnetic
                    >
                        GitHub <span aria-hidden="true">↗</span>
                    </a>
                </div>

                <div class="hero-footnote">
                    <span class="pulse-dot" aria-hidden="true"></span>
                    <span>Learning in public</span>
                    <span class="footnote-divider"></span>
                    <span>Beijing · China</span>
                </div>
            </div>

            <div class="liquid-lab" data-runtime-lab data-reveal aria-label="交互式 Agent runtime 演示">
                <div class="goo-cluster" aria-hidden="true">
                    <span class="goo goo--one"></span>
                    <span class="goo goo--two"></span>
                    <span class="goo goo--three"></span>
                    <span class="goo goo--four"></span>
                </div>

                <div class="runtime-card liquid-shell" data-runtime-card>
                    <div class="runtime-topbar">
                        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                        <span>AGENT / RUNTIME</span>
                        <span class="runtime-status"><i></i> tracing</span>
                    </div>

                    <div class="runtime-core">
                        <div class="core-orbit" aria-hidden="true">
                            <span class="orbit-dot"></span>
                            <div class="core-gem">
                                <svg viewBox="0 0 36 36" fill="none">
                                    <path d="M11 12.5 18 8l7 4.5v10L18 27l-7-4.5v-10Z"></path>
                                    <path d="m11 12.5 7 4.5 7-4.5M18 17v10"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <span class="core-label">CURRENT STATE</span>
                            <strong data-runtime-state>Forward progress</strong>
                        </div>
                    </div>

                    <div class="signal-row">
                        <span data-runtime-signal>observe</span>
                        <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                    </div>

                    <div class="event-list">
                        <button type="button" data-runtime-step="0" aria-pressed="false"><span class="event-index">01</span><span>plan</span><span class="event-pill complete">complete</span></button>
                        <button type="button" data-runtime-step="1" aria-pressed="true"><span class="event-index">02</span><span>tool call</span><span class="event-pill active">running</span></button>
                        <button type="button" data-runtime-step="2" aria-pressed="false"><span class="event-index">03</span><span>evaluate</span><span class="event-pill">queued</span></button>
                    </div>
                </div>

                <div class="floating-chip floating-chip--top" aria-hidden="true">
                    <span>∞</span> long horizon
                </div>
                <div class="floating-chip floating-chip--bottom" aria-hidden="true">
                    <span>↻</span> recoverable
                </div>
            </div>
        </section>

        <section class="systems-section" data-reveal data-tabs>
            <div class="section-heading systems-heading">
                <div>
                    <p class="section-label">ENGINEERING SURFACES</p>
                    <h2>A reliable agent is a system.</h2>
                </div>
                <p>从运行时到评估，每一层都需要被显式设计。</p>
            </div>

            <div class="systems-card liquid-shell">
                <div class="tab-list" role="tablist" aria-label="Agent engineering layers">
                    <span class="tab-slider" aria-hidden="true"></span>
                    {systemLayers.map((layer, index) => (
                        <button
                            type="button"
                            role="tab"
                            id={`tab-${layer.id}`}
                            aria-controls={`panel-${layer.id}`}
                            aria-selected={index === 0 ? 'true' : 'false'}
                            tabindex={index === 0 ? 0 : -1}
                        >
                            <span>{layer.index}</span>{layer.tab}
                        </button>
                    ))}
                </div>

                <div class="tab-panels">
                    {systemLayers.map((layer, index) => (
                        <div
                            class={`system-panel system-panel--${layer.color}`}
                            role="tabpanel"
                            id={`panel-${layer.id}`}
                            aria-labelledby={`tab-${layer.id}`}
                            hidden={index !== 0}
                        >
                            <div class="system-copy">
                                <span class="panel-index">LAYER / {layer.index}</span>
                                <h3>{layer.title}</h3>
                                <p>{layer.description}</p>
                            </div>
                            <ul>
                                {layer.signals.map((signal, signalIndex) => (
                                    <li>
                                        <span>{String(signalIndex + 1).padStart(2, '0')}</span>
                                        {signal}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </section>

    </main>

    <script is:inline>
        (() => {
            const lab = document.querySelector('[data-runtime-lab]');
            if (!lab) return;

            const card = lab.querySelector('[data-runtime-card]');
            const state = lab.querySelector('[data-runtime-state]');
            const signal = lab.querySelector('[data-runtime-signal]');
            const steps = Array.from(lab.querySelectorAll('[data-runtime-step]'));
            const stages = [
                { state: 'Planning next move', signal: 'plan' },
                { state: 'Forward progress', signal: 'observe' },
                { state: 'Evaluating result', signal: 'evaluate' },
            ];
            let pulseTimer;

            const selectStage = (activeIndex) => {
                steps.forEach((step, index) => {
                    const pill = step.querySelector('.event-pill');
                    const isActive = index === activeIndex;
                    step.setAttribute('aria-pressed', String(isActive));
                    pill.classList.toggle('complete', index < activeIndex);
                    pill.classList.toggle('active', isActive);
                    pill.textContent = index < activeIndex ? 'complete' : isActive ? 'running' : 'queued';
                });

                state.textContent = stages[activeIndex].state;
                signal.textContent = stages[activeIndex].signal;
                card.classList.remove('is-switching');
                void card.offsetWidth;
                card.classList.add('is-switching');
                window.clearTimeout(pulseTimer);
                pulseTimer = window.setTimeout(() => card.classList.remove('is-switching'), 620);
            };

            steps.forEach((step, index) => step.addEventListener('click', () => selectStage(index)));

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            lab.addEventListener('pointermove', (event) => {
                const bounds = lab.getBoundingClientRect();
                const x = ((event.clientX - bounds.left) / bounds.width) - .5;
                const y = ((event.clientY - bounds.top) / bounds.height) - .5;
                card.style.setProperty('--runtime-rx', `${-y * 5.5}deg`);
                card.style.setProperty('--runtime-ry', `${x * 7}deg`);
                card.style.setProperty('--runtime-lift', '-7px');
                lab.style.setProperty('--lab-light-x', `${50 + (x * 24)}%`);
                lab.style.setProperty('--lab-light-y', `${48 + (y * 20)}%`);
                lab.classList.add('is-interacting');
            });

            lab.addEventListener('pointerleave', () => {
                card.style.setProperty('--runtime-rx', '0deg');
                card.style.setProperty('--runtime-ry', '0deg');
                card.style.setProperty('--runtime-lift', '0px');
                lab.classList.remove('is-interacting');
            });
        })();
    </script>
</BaseLayout>

<style>
    .home { width: var(--page-width); margin: 0 auto; }

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.06fr) minmax(400px, .94fr);
        align-items: center;
        min-height: 680px;
        gap: clamp(40px, 7vw, 96px);
        padding: 54px 0 92px;
    }

    .eyebrow, .section-label {
        margin: 0;
        color: var(--color-muted);
        font-family: 'DM Mono', monospace;
        font-size: .7rem;
        font-weight: 500;
        letter-spacing: .13em;
    }

    .eyebrow { display: flex; align-items: center; gap: 10px; }
    .eyebrow > span { width: 7px; height: 7px; border-radius: 50%; background: var(--color-lime); box-shadow: 0 0 0 5px rgb(185 243 106 / 18%); }

    h1 {
        max-width: 760px;
        margin: 24px 0 28px;
        font-size: clamp(3.5rem, 7.2vw, 6.8rem);
        font-weight: 700;
        line-height: .94;
        letter-spacing: -.075em;
    }

    .liquid-title { position: relative; display: inline-block; z-index: 0; }
    .liquid-title::before {
        position: absolute;
        z-index: -1;
        right: -.16em;
        bottom: .02em;
        left: -.07em;
        height: .32em;
        border-radius: 999px 40% 999px 48%;
        background: linear-gradient(90deg, var(--color-lime), var(--color-cyan));
        box-shadow: inset 0 2px 3px rgb(255 255 255 / 58%), 0 7px 16px rgb(86 169 157 / 16%);
        content: '';
        transform: rotate(-1.5deg);
    }
    .liquid-title i { position: absolute; right: -.22em; bottom: .23em; width: .12em; height: .12em; border-radius: 50%; background: var(--color-cyan); box-shadow: inset 0 1px 1px rgb(255 255 255 / 70%), 0 4px 8px rgb(56 150 160 / 20%); }

    .intro { max-width: 650px; margin: 0; color: var(--color-muted); font-size: clamp(1rem, 1.6vw, 1.16rem); line-height: 1.8; }

    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
    .actions a { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; text-decoration: none; }

    .primary-action {
        gap: 22px;
        padding: 6px 7px 6px 20px;
        border-radius: 17px 20px 16px 19px;
        background: var(--color-text);
        color: var(--color-background);
        box-shadow: 0 2px 2px rgb(13 25 21 / 18%), 0 10px 24px rgb(13 25 21 / 18%), inset 0 1px 0 rgb(255 255 255 / 15%);
        font-size: .86rem;
        font-weight: 700;
    }
    .action-orb { display: grid; width: 39px; height: 39px; border-radius: 13px 15px 12px 14px; background: var(--color-lime); color: #18201e; font-size: 1rem; box-shadow: inset 0 1px 1px rgb(255 255 255 / 72%); place-items: center; transition: transform 500ms var(--ease-spring); }
    .primary-action:hover .action-orb { transform: rotate(42deg) scale(1.05); }

    .secondary-action { gap: 18px; padding: 0 20px; border: 1px solid var(--color-border); border-radius: 17px 19px 16px 18px; background: var(--color-surface); box-shadow: var(--shadow-micro); color: var(--color-muted); font-size: .86rem; font-weight: 700; backdrop-filter: blur(12px); }
    .secondary-action:hover { color: var(--color-accent); border-color: var(--color-border-strong); }

    .hero-footnote { display: flex; align-items: center; gap: 10px; margin-top: 48px; color: var(--color-muted); font-family: 'DM Mono', monospace; font-size: .64rem; letter-spacing: .06em; }
    .pulse-dot { width: 6px; height: 6px; border-radius: 50%; background: #63cf72; box-shadow: 0 0 0 4px rgb(99 207 114 / 14%); animation: pulse 2.6s ease-in-out infinite; }
    .footnote-divider { width: 20px; height: 1px; background: var(--color-border-strong); }

    .liquid-lab { --lab-light-x: 50%; --lab-light-y: 48%; position: relative; min-height: 520px; isolation: isolate; }
    .liquid-lab::after { position: absolute; z-index: 1; inset: 8% 0; border-radius: 50%; opacity: 0; background: radial-gradient(circle at var(--lab-light-x) var(--lab-light-y), rgb(255 255 255 / 30%), transparent 34%); content: ''; pointer-events: none; transition: opacity 300ms ease; }
    .liquid-lab.is-interacting::after { opacity: .7; }
    .goo-cluster { position: absolute; z-index: -1; inset: 0; filter: url('#goo'); }
    .goo { position: absolute; display: block; border-radius: 50%; }
    .goo--one { top: 6%; right: 5%; width: 300px; height: 300px; background: linear-gradient(140deg, var(--color-cyan), var(--color-accent-soft)); animation: liquid-float 8s ease-in-out infinite; }
    .goo--two { right: -3%; bottom: 7%; width: 220px; height: 220px; background: linear-gradient(150deg, var(--color-lime), #d6fdb9); animation: liquid-float 7s 1.2s ease-in-out infinite reverse; }
    .goo--three { top: 4%; left: 6%; width: 110px; height: 110px; background: var(--color-lime); animation: droplet 6s ease-in-out infinite; }
    .goo--four { bottom: 2%; left: 12%; width: 92px; height: 92px; background: var(--color-cyan); animation: droplet 5.4s 1s ease-in-out infinite reverse; }

    .runtime-card { --runtime-rx: 0deg; --runtime-ry: 0deg; --runtime-lift: 0px; position: absolute; z-index: 2; top: 55px; right: 14px; width: min(90%, 410px); min-height: 405px; padding: 18px; border-radius: 34px 42px 31px 38px; transform: perspective(900px) translateY(var(--runtime-lift)) rotateX(var(--runtime-rx)) rotateY(var(--runtime-ry)) rotateZ(2deg); transition: transform 620ms var(--ease-spring); transform-style: preserve-3d; will-change: transform; }

    .runtime-topbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; color: var(--color-muted); font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .1em; }
    .window-dots { display: flex; gap: 4px; }
    .window-dots span { width: 5px; height: 5px; border-radius: 50%; background: var(--color-border-strong); }
    .runtime-status { display: flex; align-items: center; justify-self: end; gap: 5px; color: var(--color-text); letter-spacing: 0; }
    .runtime-status i { width: 5px; height: 5px; border-radius: 50%; background: var(--color-lime); box-shadow: 0 0 0 3px rgb(185 243 106 / 18%); }

    .runtime-core { display: flex; align-items: center; gap: 22px; margin: 42px 8px 32px; }
    .core-orbit { position: relative; display: grid; width: 88px; height: 88px; border: 1px dashed var(--color-border-strong); border-radius: 50%; place-items: center; animation: spin 18s linear infinite; }
    .core-gem { display: grid; width: 62px; height: 62px; border-radius: 21px 25px 20px 23px; background: linear-gradient(145deg, var(--color-accent), #8587ff); box-shadow: 0 14px 28px rgb(91 92 240 / 28%), inset 0 1px 1px rgb(255 255 255 / 35%); place-items: center; transform: rotate(-8deg); }
    .core-gem svg { width: 34px; height: 34px; stroke: white; stroke-width: 1.4; }
    .orbit-dot { position: absolute; top: 7px; right: 6px; width: 10px; height: 10px; border: 2px solid var(--color-surface-solid); border-radius: 50%; background: var(--color-lime); }
    .core-label { display: block; margin-bottom: 6px; color: var(--color-muted); font-family: 'DM Mono', monospace; font-size: .58rem; letter-spacing: .1em; }
    .runtime-core strong { font-size: 1rem; letter-spacing: -.025em; }

    .signal-row { display: flex; align-items: flex-end; height: 41px; gap: 5px; padding: 8px 10px; border: 1px solid var(--color-border); border-radius: 13px; background: rgb(128 143 139 / 5%); }
    .signal-row span { align-self: center; margin-right: auto; color: var(--color-muted); font-family: 'DM Mono', monospace; font-size: .58rem; }
    .signal-row i { width: 8px; border-radius: 4px; background: linear-gradient(to top, var(--color-accent), var(--color-cyan)); animation: meter 2.2s ease-in-out infinite alternate; }
    .signal-row i:nth-of-type(1) { height: 10px; } .signal-row i:nth-of-type(2) { height: 19px; animation-delay: -.4s; } .signal-row i:nth-of-type(3) { height: 13px; animation-delay: -.8s; } .signal-row i:nth-of-type(4) { height: 24px; animation-delay: -1.1s; } .signal-row i:nth-of-type(5) { height: 17px; animation-delay: -.2s; } .signal-row i:nth-of-type(6) { height: 9px; animation-delay: -.7s; } .signal-row i:nth-of-type(7) { height: 21px; animation-delay: -1.4s; }

    .event-list { display: grid; gap: 5px; margin-top: 9px; }
    .event-list > button { display: grid; grid-template-columns: 30px 1fr auto; align-items: center; min-height: 40px; padding: 0 10px; border: 0; border-bottom: 1px solid var(--color-border); border-radius: 10px; background: transparent; color: var(--color-text); font: inherit; font-size: .68rem; text-align: left; cursor: pointer; transition: background 220ms ease, transform 420ms var(--ease-spring); }
    .event-list > button:hover, .event-list > button[aria-pressed='true'] { background: rgb(128 143 139 / 7%); transform: translateX(4px); }
    .event-list > button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
    .event-index { color: var(--color-muted); font-family: 'DM Mono', monospace; }
    .event-pill { padding: 4px 7px; border-radius: 999px; background: rgb(128 143 139 / 9%); color: var(--color-muted); font-family: 'DM Mono', monospace; font-size: .52rem; }
    .event-pill.complete { background: rgb(185 243 106 / 20%); color: var(--color-text); }
    .event-pill.active { background: rgb(115 230 255 / 20%); color: var(--color-text); }
    .runtime-card.is-switching .core-gem { animation: runtime-pop 600ms var(--ease-spring); }

    .floating-chip { position: absolute; z-index: 4; display: flex; align-items: center; gap: 8px; padding: 8px 12px 8px 8px; border: 1px solid rgb(255 255 255 / 55%); border-radius: 14px 18px 13px 16px; background: var(--color-surface); box-shadow: var(--shadow-float); color: var(--color-muted); font-family: 'DM Mono', monospace; font-size: .58rem; backdrop-filter: blur(16px); animation: chip-float 5s ease-in-out infinite; }
    .floating-chip span { display: grid; width: 23px; height: 23px; border-radius: 8px 10px 7px 9px; background: var(--color-lime); color: #18201e; font: 600 .8rem 'Manrope', sans-serif; place-items: center; }
    .floating-chip--top { top: 34px; left: -5px; transform: rotate(-5deg); }
    .floating-chip--bottom { right: -2px; bottom: 58px; transform: rotate(4deg); animation-delay: -2.5s; }
    .floating-chip--bottom span { background: var(--color-cyan); }

    .systems-section { padding: 104px 0; border-top: 1px solid var(--color-border); }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 34px; }
    .section-heading h2 { max-width: 720px; margin: 10px 0 0; font-size: clamp(2.1rem, 4.5vw, 4rem); font-weight: 650; line-height: 1.05; letter-spacing: -.06em; }
    .systems-heading > p { max-width: 300px; margin: 0; color: var(--color-muted); font-size: .88rem; line-height: 1.7; }

    .systems-card { overflow: hidden; padding: 12px; border-radius: 30px 36px 28px 34px; }
    .tab-list { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); padding: 4px; border: 1px solid var(--color-border); border-radius: 18px; background: rgb(128 143 139 / 6%); }
    .tab-list button { position: relative; z-index: 1; min-height: 50px; padding: 0 20px; border: 0; background: transparent; color: var(--color-muted); font-size: .78rem; font-weight: 700; cursor: pointer; transition: color 250ms ease; }
    .tab-list button span { margin-right: 10px; font-family: 'DM Mono', monospace; font-size: .58rem; opacity: .65; }
    .tab-list button[aria-selected='true'] { color: var(--color-text); }
    .tab-list button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -3px; border-radius: 14px; }
    .tab-slider { position: absolute; z-index: 0; top: 4px; bottom: 4px; left: 0; border: 1px solid rgb(255 255 255 / 58%); border-radius: 14px 17px 13px 16px; background: linear-gradient(140deg, rgb(255 255 255 / 84%), rgb(255 255 255 / 40%)); box-shadow: 0 4px 11px rgb(var(--color-shadow) / 9%), inset 0 1px 0 rgb(255 255 255 / 86%); transition: width 560ms var(--ease-spring), transform 560ms var(--ease-spring); }
    :global(:root[data-theme='night']) .tab-slider { border-color: rgb(255 255 255 / 9%); background: linear-gradient(140deg, rgb(141 142 255 / 18%), rgb(255 255 255 / 5%)); }

    .system-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .72fr); min-height: 325px; gap: 50px; padding: clamp(34px, 6vw, 68px); border-radius: 23px 28px 22px 26px; background: radial-gradient(circle at 78% 36%, var(--panel-glow), transparent 28%), linear-gradient(140deg, rgb(255 255 255 / 30%), transparent); animation: panel-in 520ms var(--ease-spring); }
    .system-panel--lime { --panel-glow: rgb(185 243 106 / 20%); }
    .system-panel--cyan { --panel-glow: rgb(115 230 255 / 20%); }
    .system-panel--violet { --panel-glow: rgb(91 92 240 / 16%); }
    .system-panel[hidden] { display: none; }
    .panel-index { color: var(--color-accent); font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .1em; }
    .system-copy h3 { max-width: 560px; margin: 20px 0 16px; font-size: clamp(2rem, 4.3vw, 3.8rem); font-weight: 650; line-height: 1; letter-spacing: -.06em; }
    .system-copy p { max-width: 560px; margin: 0; color: var(--color-muted); font-size: .92rem; line-height: 1.85; }
    .system-panel ul { display: grid; align-self: center; gap: 0; margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
    .system-panel li { display: grid; grid-template-columns: 32px 1fr; align-items: center; padding: 17px 3px; border-bottom: 1px solid var(--color-border); font-size: .8rem; font-weight: 650; }
    .system-panel li span { color: var(--color-muted); font-family: 'DM Mono', monospace; font-size: .58rem; }

    @keyframes liquid-float { 0%, 100% { transform: translate3d(0, 0, 0) scale(1); border-radius: 50% 46% 52% 44%; } 50% { transform: translate3d(-10px, 18px, 0) scale(1.05, .96); border-radius: 44% 55% 46% 54%; } }
    @keyframes droplet { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(24px, 20px) scale(.84, 1.13); } }
    @keyframes chip-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -9px; } }
