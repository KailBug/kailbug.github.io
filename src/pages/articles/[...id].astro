---
import {
    getCollection,
    render,
    type CollectionEntry,
} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const articles = await getCollection(
        'blog',
        ({ data }) => !data.draft,
    );

    return articles.map((article) => ({
        params: { id: article.id },
        props: { article },
    }));
}

interface Props {
    article: CollectionEntry<'blog'>;
}

const { article } = Astro.props;
const { Content } = await render(article);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
});

function estimateReadingMinutes(body = '') {
    const chineseCharacters =
        body.match(/[\u3400-\u9fff]/g)?.length ?? 0;
    const englishWords =
        body.replace(/[\u3400-\u9fff]/g, ' ').match(/[a-zA-Z0-9]+/g)?.length ?? 0;

    return Math.max(
        1,
        Math.ceil(chineseCharacters / 400 + englishWords / 220),
    );
}
---

<BaseLayout
        title={`${article.data.title} | KailBug`}
        description={article.data.description}
>
    <main class="article-page">
        <a class="back-link" href="/articles/">← Articles</a>

        <article>
            <header class="article-header">
                <p class="category">{article.data.category}</p>
                <h1>{article.data.title}</h1>
                <p class="description">{article.data.description}</p>

                <div class="meta">
                    <time datetime={article.data.date.toISOString()}>
                        {dateFormatter.format(article.data.date)}
                    </time>
                    <span>{estimateReadingMinutes(article.body)} 分钟阅读</span>
                </div>

                <ul class="tags" aria-label="标签">
                    {article.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
            </header>

            <div class="prose">
                <Content />
            </div>
        </article>
    </main>
</BaseLayout>

<style>
    .article-page {
        width: min(760px, calc(100% - 40px));
        margin: 0 auto;
        padding: 64px 0 96px;
    }

    .back-link {
        color: var(--color-muted);
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--color-accent);
    }

    .article-header {
        margin: 48px 0;
        padding-bottom: 32px;
        border-bottom: 1px solid var(--color-border);
    }

    .category {
        margin: 0 0 12px;
        color: var(--color-accent);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.25rem, 7vw, 4rem);
        line-height: 1.12;
        letter-spacing: -0.045em;
    }

    .description {
        margin: 20px 0;
        color: var(--color-muted);
        font-size: 1.1rem;
        line-height: 1.8;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        color: #68758a;
        font-size: 0.9rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 20px 0 0;
        padding: 0;
        list-style: none;
    }

    .tags li {
        padding: 5px 10px;
        border-radius: 999px;
        background: #eef4ff;
        color: #315a9d;
        font-size: 0.8rem;
    }

    .prose {
        font-size: 1.05rem;
        line-height: 1.85;
    }

    .prose :global(h2) {
        margin: 2.5em 0 0.8em;
        font-size: 1.7rem;
        line-height: 1.3;
    }

    .prose :global(p) {
        margin: 1.2em 0;
    }

    .prose :global(a) {
        color: var(--color-accent);
    }

    .prose :global(blockquote) {
        margin: 1.5em 0;
        padding: 0.25em 1.25em;
        border-left: 4px solid var(--color-accent);
        background: #f5f8fd;
        color: #46546b;
    }

    .prose :global(pre) {
        overflow-x: auto;
        margin: 1.5em 0;
        padding: 20px;
        border-radius: 12px;
    }

    .prose :global(code) {
        font-family: "JetBrains Mono", Consolas, monospace;
    }

    .prose :global(p code),
    .prose :global(li code) {
        padding: 0.15em 0.35em;
        border-radius: 4px;
        background: #eef1f5;
        font-size: 0.9em;
    }

    .prose :global(table) {
        display: block;
        overflow-x: auto;
        width: max-content;
        max-width: 100%;
        margin: 1.5em 0;
        border-collapse: collapse;
    }

    .prose :global(th),
    .prose :global(td) {
        padding: 10px 14px;
        border: 1px solid var(--color-border);
        text-align: left;
    }

    .prose :global(th) {
        background: #f5f8fd;
    }

    .prose :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
    }
</style>