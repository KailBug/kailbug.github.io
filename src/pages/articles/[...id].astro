---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const articles = await getCollection('blog', ({ data }) => !data.draft);
    return articles.map((article) => ({
        params: { id: article.id },
        props: { article },
    }));
}

interface Props {
    article: CollectionEntry<'blog'>;
}

const { article } = Astro.props;
const { Content } = await render(article);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
});

function estimateReadingMinutes(body = '') {
    const chineseCharacters = body.match(/[\u3400-\u9fff]/g)?.length ?? 0;
    const englishWords = body.replace(/[\u3400-\u9fff]/g, ' ').match(/[a-zA-Z0-9]+/g)?.length ?? 0;
    return Math.max(1, Math.ceil(chineseCharacters / 400 + englishWords / 220));
}
---

<BaseLayout title={`${article.data.title} | KailBug`} description={article.data.description}>
    <main class="article-page">
        <a class="back-link magnetic" href="/articles/" data-magnetic>
            <span>←</span> All articles
        </a>

        <article>
            <header class="article-header" data-reveal>
                <div class="category-row">
                    <p class="category"><span></span>{article.data.category}</p>
                    <span class="article-code">NOTE / 001</span>
                </div>

                <h1>{article.data.title}</h1>
                <p class="description">{article.data.description}</p>

                <div class="header-footer">
                    <div class="meta">
                        <time datetime={article.data.date.toISOString()}>{dateFormatter.format(article.data.date)}</time>
                        <span>{estimateReadingMinutes(article.body)} 分钟阅读</span>
                    </div>

                    <ul class="tags" aria-label="标签">
                        {article.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                </div>

                <div class="header-goo" aria-hidden="true"><span></span><i></i></div>
            </header>

            <div class="article-layout">
                <aside class="reading-rail" aria-label="阅读提示" data-reveal>
                    <span class="rail-line"><i></i></span>
                    <span>READING</span>
                </aside>

                <div class="prose" data-reveal>
                    <Content />
                </div>
            </div>
        </article>

        <div class="article-end liquid-shell" data-reveal>
            <div class="end-orb" aria-hidden="true">✓</div>
            <div>
                <span>END OF NOTE</span>
                <strong>Thanks for reading.</strong>
            </div>
            <a class="magnetic" href="/articles/" data-magnetic>More articles <span>↗</span></a>
        </div>
    </main>
</BaseLayout>

<style>
    .article-page { width: min(960px, calc(100% - 40px)); margin: 0 auto; padding: 55px 0 30px; }
    .back-link { display: inline-flex; align-items: center; gap: 10px; color: var(--color-muted); font-size: .74rem; font-weight: 700; text-decoration: none; }
    .back-link > span { display: grid; width: 34px; height: 34px; border: 1px solid var(--color-border); border-radius: 11px 14px 10px 13px; background: var(--color-surface); box-shadow: var(--shadow-micro); color: var(--color-text); place-items: center; }
    .back-link:hover { color: var(--color-accent); }

    .article-header { position: relative; overflow: hidden; margin: 52px 0 94px; padding: clamp(42px, 8vw, 82px) 0 54px; border-bottom: 1px solid var(--color-border); }
    .category-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .category { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--color-muted); font: 500 .65rem 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
    .category span { width: 7px; height: 7px; border-radius: 50%; background: var(--color-lime); box-shadow: 0 0 0 5px rgb(185 243 106 / 16%); }
    .article-code { color: var(--color-muted); font: 400 .58rem 'DM Mono', monospace; letter-spacing: .1em; }
    h1 { position: relative; z-index: 1; max-width: 900px; margin: 32px 0 24px; font-size: clamp(2.8rem, 7.5vw, 6rem); font-weight: 670; line-height: 1.02; letter-spacing: -.065em; text-wrap: balance; }
    .description { position: relative; z-index: 1; max-width: 700px; margin: 0; color: var(--color-muted); font-size: clamp(1rem, 2vw, 1.18rem); line-height: 1.8; }
    .header-footer { position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; margin-top: 50px; }
    .meta { display: flex; flex-wrap: wrap; gap: 9px 20px; color: var(--color-muted); font: 400 .62rem 'DM Mono', monospace; }
    .tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; margin: 0; padding: 0; list-style: none; }
    .tags li { padding: 6px 10px; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface); color: var(--color-muted); font: 400 .55rem 'DM Mono', monospace; }

    .header-goo { position: absolute; z-index: 0; top: 27%; right: -48px; width: 190px; height: 190px; opacity: .32; border-radius: 45% 55% 51% 49% / 55% 44% 56% 45%; background: linear-gradient(145deg, var(--color-cyan), var(--color-accent-soft)); filter: blur(.2px); transform: rotate(12deg); }
    .header-goo span { position: absolute; top: -25px; left: -18px; width: 54px; height: 54px; border-radius: 50%; background: var(--color-lime); }
    .header-goo i { position: absolute; right: 22px; bottom: -12px; width: 34px; height: 34px; border-radius: 50%; background: var(--color-accent); }

    .article-layout { display: grid; grid-template-columns: 56px minmax(0, 760px); gap: 28px; justify-content: center; }
    .reading-rail { position: sticky; top: 30px; display: flex; align-items: center; flex-direction: column; align-self: start; height: 165px; gap: 13px; color: var(--color-muted); font: 400 .52rem 'DM Mono', monospace; letter-spacing: .13em; writing-mode: vertical-rl; }
    .rail-line { position: relative; display: block; width: 1px; height: 90px; overflow: hidden; background: var(--color-border); }
    .rail-line i { position: absolute; top: 0; left: 0; width: 1px; height: 35%; background: var(--color-accent); animation: reading-line 2.8s ease-in-out infinite; }

    .prose { width: 100%; min-width: 0; color: var(--color-text); font-size: 1.03rem; line-height: 1.95; }
    .prose :global(h2) { margin: 2.8em 0 .9em; font-size: clamp(1.65rem, 3vw, 2.2rem); line-height: 1.25; letter-spacing: -.04em; }
    .prose :global(h3) { margin: 2.2em 0 .75em; font-size: 1.35rem; letter-spacing: -.025em; }
    .prose :global(p) { margin: 1.35em 0; }
    .prose :global(strong) { color: var(--color-text); font-weight: 750; }
    .prose :global(a) { color: var(--color-accent); text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .prose :global(blockquote) { margin: 1.8em 0; padding: 20px 25px; border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); border-radius: 6px 18px 16px 7px; background: var(--color-surface); box-shadow: var(--shadow-micro); color: var(--color-muted); }
    .prose :global(pre) { overflow-x: auto; margin: 1.8em 0; padding: 22px; border: 1px solid rgb(255 255 255 / 8%); border-radius: 18px 23px 17px 21px; background: #151d1c !important; box-shadow: 0 16px 35px rgb(10 18 16 / 15%), inset 0 1px 0 rgb(255 255 255 / 7%); color: #eaf3ef; font-size: .88rem; line-height: 1.75; }
    .prose :global(code) { font-family: 'DM Mono', Consolas, monospace; }
    .prose :global(p code), .prose :global(li code) { padding: .18em .4em; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-surface); color: var(--color-accent); font-size: .86em; }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; }
    .prose :global(li) { margin: .55em 0; padding-left: .25em; }
    .prose :global(table) { display: block; overflow-x: auto; width: max-content; max-width: 100%; margin: 1.8em 0; border-collapse: separate; border: 1px solid var(--color-border); border-radius: 14px; border-spacing: 0; }
    .prose :global(th), .prose :global(td) { padding: 11px 15px; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); text-align: left; }
    .prose :global(th) { background: var(--color-surface); }
    .prose :global(img) { max-width: 100%; height: auto; margin: 2em 0; border: 1px solid var(--color-border); border-radius: 18px 24px 17px 21px; box-shadow: var(--shadow-soft); }
    .prose :global(hr) { margin: 3.5em 0; border: 0; border-top: 1px solid var(--color-border); }

    .article-end { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 20px; margin: 90px auto 0; padding: 24px; border-radius: 22px 28px 21px 25px; }
    .end-orb { display: grid; width: 48px; height: 48px; border-radius: 16px 20px 15px 18px; background: linear-gradient(145deg, var(--color-lime), var(--color-cyan)); box-shadow: inset 0 1px 1px rgb(255 255 255 / 70%); color: #18201e; place-items: center; }
    .article-end > div:nth-child(2) { display: grid; gap: 4px; }
    .article-end > div span { color: var(--color-muted); font: 400 .52rem 'DM Mono', monospace; letter-spacing: .1em; }
    .article-end strong { font-size: .82rem; }
    .article-end > a { display: inline-flex; align-items: center; gap: 12px; color: var(--color-muted); font-size: .7rem; font-weight: 700; text-decoration: none; }
    .article-end > a span { display: grid; width: 33px; height: 33px; border-radius: 11px; background: var(--color-text); color: var(--color-background); place-items: center; }

    @keyframes reading-line { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(300%); } }

    @media (max-width: 700px) {
        .article-page { width: min(100% - 24px, 960px); padding-top: 40px; }
        .article-header { margin-bottom: 66px; }
        .header-footer { align-items: flex-start; flex-direction: column; }
        .tags { justify-content: flex-start; }
        .article-layout { grid-template-columns: minmax(0, 1fr); min-width: 0; }
        .reading-rail { display: none; }
        .prose { font-size: .98rem; line-height: 1.9; }
        .article-end { grid-template-columns: auto 1fr; }
        .article-end > a { grid-column: 1 / -1; justify-content: space-between; margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--color-border); }
    }
</style>
